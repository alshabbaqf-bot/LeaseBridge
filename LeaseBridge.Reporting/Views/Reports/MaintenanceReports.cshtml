@model LeaseBridge.Reporting.ViewModels.MaintenanceReportsViewModel

@{
    ViewData["Title"] = "Maintenance Reports";
}

<div class="container mt-4">

    <div class="mb-4 pb-2 border-bottom">
        <h1 class="text-navy fw-bold mb-0">Maintenance Reports</h1>
    </div>

    <h3 class="text-navy fw-bold mb-4">
        Maintenance Requests Report
    </h3>

    <div class="row g-3 mb-4">

        <!-- Total Requests -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Total Requests</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.TotalRequests
                </h3>
            </div>
        </div>

        <!-- Open Requests -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Open Requests</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.OpenRequests
                </h3>
            </div>
        </div>

        <!-- Completed Requests -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Completed Requests</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.CompletedRequests
                </h3>
            </div>
        </div>

    </div>

    <!-- Chart -->
    <div class="card-custom p-4 shadow-sm mb-4">

        <h4 class="text-navy fw-bold mb-3">
            Requests by Status
        </h4>

        <div style="max-width:500px; margin:auto;">
            <canvas id="maintenanceChart"></canvas>
        </div>

    </div>

    <!-- High Priority Requests -->
    <div class="card-custom p-4 shadow-sm">

        <h4 class="text-navy fw-bold mb-3">
            High Priority Requests
        </h4>

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Unit</th>
                    <th>Title</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.HighPriorityRequests.Any())
                {
                    @foreach (var request in Model.HighPriorityRequests)
                    {
                        <tr>
                            <td>@request.RequestId</td>
                            <td>@request.UnitNumber</td>
                            <td>@request.Title</td>
                            <td>@request.Status</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            No high priority requests found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const maintenanceCtx =
        document.getElementById('maintenanceChart');

    new Chart(maintenanceCtx, {

        type: 'doughnut',

        data: {

            labels: [
                'Open',
                'In Progress',
                'Completed'
            ],

            datasets: [{
                data: [
                    @Model.Statistics.OpenRequests,
                    @Model.Statistics.InProgressRequests,
                    @Model.Statistics.CompletedRequests
                ]
            }]
        }
    });

</script>