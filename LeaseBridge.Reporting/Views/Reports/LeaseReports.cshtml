@model LeaseBridge.Reporting.ViewModels.LeaseReportsViewModel

@{
    ViewData["Title"] = "Lease Reports";
}

@* <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> *@

<div class="container mt-4">
    
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="text-navy fw-bold mb-0">Lease Reports</h1>
    </div>

    <h3 class="text-navy fw-bold mb-4">Occupancy Report</h3>

    <div class="row g-3 mb-4">

        <!-- Total Units -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Total Units</small>
                <h3 class="text-navy fw-bold">@Model.OccupancyStatistics.TotalUnits</h3>
            </div>
        </div>

        <!-- Occupied -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Occupied Units</small>
                <h3 class="text-navy fw-bold">@Model.OccupancyStatistics.OccupiedUnits</h3>
            </div>
        </div>

        <!-- Vacant -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Available Units</small>
                <h3 class="text-navy fw-bold">@Model.OccupancyStatistics.AvailableUnits</h3>
            </div>
        </div>

        <!-- Occupancy Rate -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Occupancy Rate:</small>
                <h3 class="text-navy fw-bold">@Model.OccupancyStatistics.OccupiedPercentage%</h3>
            </div>
        </div>

        <div class="card-custom p-4 shadow-sm">
            <h5 class="text-navy fw-bold mb-3">Unit Occupancy Distribution</h5>

            <div class="d-flex justify-content-center">
                <div style="width:350px; height:350px;">
                    <canvas id="occupancyChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card-custom p-4 shadow-sm mt-4">

            <h4 class="text-navy fw-bold mb-3">
                Occupancy by Property
            </h4>

            <table class="table table-striped">

                <thead>
                    <tr>
                        <th>Property</th>
                        <th>Occupied</th>
                        <th>Vacant</th>
                        <th>Total</th>
                        <th>Occupancy Rate</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var property in Model.PropertyOccupancies)
                    {
                        <tr>
                            <td>@property.PropertyName</td>
                            <td>@property.OccupiedUnits</td>
                            <td>@property.AvailableUnits</td>
                            <td>@property.TotalUnits</td>
                            <td>@property.OccupancyRate%</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('occupancyChart');

    new Chart(ctx, {
        type: 'pie',
        data: {
            labels: ['Available', 'Occupied'],
            datasets: [{
                data: [
                    @Model.OccupancyStatistics.AvailableUnits,
                    @Model.OccupancyStatistics.OccupiedUnits
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
</script>

