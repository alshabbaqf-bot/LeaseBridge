@model LeaseBridge.Reporting.ViewModels.InvoiceReportsViewModel

@{
    ViewData["Title"] = "Invoice Reports";
}

<div class="container mt-4">

    <div class="mb-4 pb-2 border-bottom">
        <h1 class="text-navy fw-bold mb-0">Invoice Reports</h1>
    </div>

    <h3 class="text-navy fw-bold mb-4">Invoice Status Report</h3>

    <div class="row g-3 mb-4">

        <!-- Total Payments -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Total Payments</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.TotalPayments
                </h3>
            </div>
        </div>

        <!-- Total Revenue -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Total Revenue</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.TotalRevenue.ToString("C")
                </h3>
            </div>
        </div>

        <!-- Overdue Invoices -->
        <div class="col-md-4">
            <div class="card-custom p-3 shadow-sm border-top border-navy border-3">
                <small class="text-muted">Overdue Invoices</small>
                <h3 class="text-navy fw-bold">
                    @Model.Statistics.OverdueInvoices
                </h3>
            </div>
        </div>

    </div>

    <!-- Chart -->
    <div class="card-custom p-4 shadow-sm mb-4">

        <h4 class="text-navy fw-bold mb-3">
            Invoice Status Distribution
        </h4>

        <div style="max-width:500px; margin:auto;">
            <canvas id="invoiceChart"></canvas>
        </div>

    </div>

    <!-- Overdue Invoices Table -->
    <div class="card-custom p-4 shadow-sm">

        <h4 class="text-navy fw-bold mb-3">
            Overdue Invoices
        </h4>

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Invoice No.</th>
                    <th>Tenant</th>
                    <th>Amount</th>
                    <th>Due Date</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.OverdueInvoices.Any())
                {
                    @foreach (var invoice in Model.OverdueInvoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNumber</td>
                            <td>@invoice.TenantName</td>
                            <td>@invoice.Amount.ToString("C")</td>
                            <td>@invoice.DueDate.ToShortDateString()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">
                            No overdue invoices found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const invoiceCtx =
        document.getElementById('invoiceChart');

    new Chart(invoiceCtx, {

        type: 'doughnut',

        data: {

            labels: [
                'Paid',
                'Pending',
                'Overdue'
            ],

            datasets: [{
                data: [
                    @Model.Statistics.PaidInvoices,
                    @Model.Statistics.PendingInvoices,
                    @Model.Statistics.OverdueInvoices
                ]
            }]
        }
    });

</script>