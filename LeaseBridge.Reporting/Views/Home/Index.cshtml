<script>

    const invoiceMonths =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.InvoiceStatusByMonth
                    .Select(x => x.Month)));

    const paidInvoices =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.InvoiceStatusByMonth
                                .Select(x => x.PaidCount)));

    const pendingInvoices =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.InvoiceStatusByMonth
                                .Select(x => x.PendingCount)));

    const overdueInvoices =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.InvoiceStatusByMonth
                                .Select(x => x.OverdueCount)));

    new Chart(
        document.getElementById('paymentsChart'),
        {
            type: 'bar',

            data: {
                labels: invoiceMonths,

                datasets: [
                    {
                        label: 'Paid',
                        data: paidInvoices
                    },
                    {
                        label: 'Pending',
                        data: pendingInvoices
                    },
                    {
                        label: 'Overdue',
                        data: overdueInvoices
                    }
                ]
            },

            options: {
                responsive: true,

                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Invoices'
                        }
                    },

                    x: {
                        title: {
                            display: true,
                            text: 'Month'
                        }
                    }
                }
            }
        });

</script>

<script>

    const maintenanceMonths =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.MaintenanceStatusByMonth
                                .Select(x => x.Month)));

    const openRequests =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.MaintenanceStatusByMonth
                                .Select(x => x.OpenRequests)));

    const inProgressRequests =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.MaintenanceStatusByMonth
                                .Select(x => x.InProgressRequests)));

    const completedRequests =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.MaintenanceStatusByMonth
                                .Select(x => x.CompletedRequests)));

    new Chart(
        document.getElementById('maintenanceChart'),
        {
            type: 'bar',

            data: {
                labels: maintenanceMonths,

                datasets: [
                    {
                        label: 'Open',
                        data: openRequests
                    },
                    {
                        label: 'In Progress',
                        data: inProgressRequests
                    },
                    {
                        label: 'Completed',
                        data: completedRequests
                    }
                ]
            },

            options: {
                responsive: true,

                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Requests'
                        }
                    },

                    x: {
                        title: {
                            display: true,
                            text: 'Month'
                        }
                    }
                }
            }
        });

</script>
