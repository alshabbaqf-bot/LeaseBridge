@model LeaseBridge.Reporting.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4 pb-2 border-bottom">
        <h1 class="text-navy fw-bold mb-0">Dashbaord</h1>
    </div>

    
    <div class="row g-4">
        
        <!-- Cards -->
        <div class="col-lg-3 col-md-6">
            <div class="card-custom p-3 border-top border-primary border-3 shadow-sm bg-white">
                <small class="text-muted fw-bold text-uppercase">
                    Total Properties
                </small>
                
                <h3 class="text-navy fw-bold mt-1">
                    @Model.Overview.TotalProperties
                </h3>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card-custom p-3 border-top border-primary border-3 shadow-sm bg-white">
                <small class="text-muted fw-bold text-uppercase">
                    Total Uints
                </small>
                
                <h3 class="text-navy fw-bold mt-1">
                    @Model.Overview.TotalUnits
                </h3>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card-custom p-3 border-top border-primary border-3 shadow-sm bg-white">
                <small class="text-muted fw-bold text-uppercase">
                    Active Leases
                </small>
                
                <h3 class="text-navy fw-bold mt-1">
                    @Model.Overview.ActiveLeases
                </h3>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card-custom p-3 border-top border-primary border-3 shadow-sm bg-white">
                <small class="text-muted fw-bold text-uppercase">
                    Occupancy Rate
                </small>
                
                <h3 class="text-navy fw-bold mt-1">
                    @Model.Occupancy.OccupiedPercentage%
                </h3>
            </div>
        </div>
        
        <!-- Charts Row -->
        <!-- Occupancy -->
        <div class="col-lg-4">
            <div class="card-custom p-4 shadow-sm h-100">

                <h5 class="text-navy fw-bold mb-3">
                    Occupancy
                </h5>

                <canvas id="occupancyChart"></canvas>

            </div>
        </div>

        <!-- Invoice Status by Month -->
        <div class="col-lg-8">
            <div class="card-custom p-4 shadow-sm h-100">

                <h5 class="text-navy fw-bold mb-3">
                    Invoice Status by Month
                </h5>

                <canvas id="paymentsChart"></canvas>

            </div>
        </div>

        <!-- Maintenance Status by Month -->
        <div class="col-12">
            <div class="card-custom p-4 shadow-sm">

                <h5 class="text-navy fw-bold mb-3">
                    Maintenance Requests by Month
                </h5>

                <canvas id="maintenanceChart"></canvas>

            </div>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    // Occupancy
    new Chart(
        document.getElementById('occupancyChart'),
        {
            type: 'doughnut',

            data: {
                labels: ['Available', 'Occupied'],

                datasets: [{
                    data: [
                        @Model.Occupancy.AvailableUnits,
                        @Model.Occupancy.OccupiedUnits
                    ]
                }]
            }
        });

