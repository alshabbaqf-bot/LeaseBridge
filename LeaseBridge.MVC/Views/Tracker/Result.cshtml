@model LeaseBridge.MVC.Controllers.MaintenanceLookupResultViewModel

@{
    ViewData["Title"] = "Maintenance Lookup Result";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Maintenance Request Status</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Ticket Number</dt>
                <dd class="col-sm-8">@Model.TicketNumber</dd>

                <dt class="col-sm-4">Tenant</dt>
                <dd class="col-sm-8">@Model.TenantName</dd>

                <dt class="col-sm-4">Property</dt>
                <dd class="col-sm-8">@Model.PropertyName</dd>

                <dt class="col-sm-4">Unit</dt>
                <dd class="col-sm-8">@Model.UnitNumber</dd>

                <dt class="col-sm-4">Issue Title</dt>
                <dd class="col-sm-8">@Model.Title</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@(Model.Description ?? "N/A")</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.CategoryName</dd>

                <dt class="col-sm-4">Priority</dt>
                <dd class="col-sm-8">@Model.PriorityName</dd>

                <dt class="col-sm-4">Current Status</dt>
                <dd class="col-sm-8">
                    @if (Model.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase) ||
                                        Model.StatusName.Equals("Closed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success">@Model.StatusName</span>
                    }
                    else if (Model.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-warning text-dark">@Model.StatusName</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-white">@Model.StatusName</span>
                    }
                </dd>

                <dt class="col-sm-4">Created At</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>

                <dt class="col-sm-4">Last Updated</dt>
                <dd class="col-sm-8">
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")
                                        : "Not updated yet")
                </dd>
            </dl>

            <a asp-controller="Tracker"
               asp-action="Index"
               class="btn btn-secondary">
                Search Again
            </a>
        </div>
    </div>
</div>