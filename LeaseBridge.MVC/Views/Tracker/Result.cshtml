@model LeaseBridge.MVC.Controllers.MaintenanceLookupResultViewModel

@{
    ViewData["Title"] = "Maintenance Lookup Result";
}

<div class="container page-container d-flex align-items-center justify-content-center">
    <div class="card card-custom w-100 shadow-lg" style="max-width: 750px;">
        <div class="card-header-navy text-center py-4">
            <h4 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2"></i>Maintenance Request Status</h4>
        </div>

        <div class="card-body p-4 p-md-5">
            <div class="row g-3 border-bottom pb-4 mb-4">
                <div class="col-sm-4 fw-bold text-navy">Ticket Number</div>
                <div class="col-sm-8 text-secondary">@Model.TicketNumber</div>

                <div class="col-sm-4 fw-bold text-navy">Tenant Name</div>
                <div class="col-sm-8 text-secondary">@Model.TenantName</div>

                <div class="col-sm-4 fw-bold text-navy">Property Location</div>
                <div class="col-sm-8 text-secondary">@Model.PropertyName</div>

                <div class="col-sm-4 fw-bold text-navy">Unit Number</div>
                <div class="col-sm-8 text-secondary">@Model.UnitNumber</div>
            </div>

            <div class="row g-3 pb-4 mb-4">
                <div class="col-sm-4 fw-bold text-navy">Issue Title</div>
                <div class="col-sm-8 fw-semibold text-dark">@Model.Title</div>

                <div class="col-sm-4 fw-bold text-navy">Description</div>
                <div class="col-sm-8 text-muted bg-light p-3 rounded-3 border">
                    @(Model.Description ?? "No description provided.")
                </div>

                <div class="col-sm-4 fw-bold text-navy">Category</div>
                <div class="col-sm-8 text-secondary">@Model.CategoryName</div>

                <div class="col-sm-4 fw-bold text-navy">Priority</div>
                <div class="col-sm-8">
                    @if (Model.PriorityName.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                        Model.PriorityName.Equals("Emergency", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-danger px-3 py-2 rounded-pill">@Model.PriorityName</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary px-3 py-2 rounded-pill">@Model.PriorityName</span>
                    }
                </div>

                <div class="col-sm-4 fw-bold text-navy">Current Status</div>
                <div class="col-sm-8">
                    @if (Model.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase) ||
                                        Model.StatusName.Equals("Closed", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>@Model.StatusName</span>
                    }
                    else if (Model.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-hourglass-split me-1"></i>@Model.StatusName</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-white px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-info-circle-fill me-1"></i>@Model.StatusName</span>
                    }
                </div>
            </div>

            <div class="row g-3 bg-light p-3 rounded-3 border mb-4 small">
                <div class="col-6 text-muted">
                    <span class="fw-bold d-block text-navy">Created At</span>
                    @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                </div>
                <div class="col-6 text-muted border-start ps-3">
                    <span class="fw-bold d-block text-navy">Last Updated</span>
                    @(Model.UpdatedAt.HasValue
                                        ? Model.UpdatedAt.Value.ToString("dd MMM yyyy HH:mm")
                                        : "Not updated yet")
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
              
                <a asp-area=""
                   asp-controller="Tracker"
                   asp-action="Index"
                   class="btn btn-navy px-4">
                    <i class="bi bi-search me-2"></i>Search Another Ticket
                </a>
            </div>
        </div>
    </div>
</div>