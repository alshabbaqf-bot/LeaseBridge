@{
    ViewData["Title"] = "Track Application";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white text-center">
            <h4 class="mb-0">Track Application Status</h4>
        </div>

        <div class="card-body p-4">
            <p class="text-muted text-center">
                Enter your application reference ID to check your rental application status.
            </p>

            <form asp-area=""
                  asp-controller="Tracker"
                  asp-action="CheckStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Application Reference ID</label>
                    <input type="number"
                           name="applicationId"
                           class="form-control"
                           placeholder="Example: 1024"
                           required />
                </div>

                <button type="submit" class="btn btn-dark w-100">
                    Check Application Status
                </button>
            </form>

            @if (ViewBag.Status != null)
            {
                <div class="alert alert-info mt-4 text-center border">
                    <strong>Status:</strong> @ViewBag.Status
                </div>
            }
        </div>
    </div>
</div>