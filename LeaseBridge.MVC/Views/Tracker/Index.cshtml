@{
    ViewData["Title"] = "Track Application";
}

<div class="container mt-5" style="max-width: 600px;">
    <!-- card style updated to card-custom -->
    <div class="card-custom shadow-sm">
        <!-- header style updated to card-header-navy -->
        <div class="card-header-navy text-center">
            <h4 class="mb-0 fw-bold"><i class="bi bi-search me-2"></i>Track Application Status</h4>
        </div>

        <div class="card-body p-4">
            <p class="text-muted text-center mb-4">
                Enter your application reference ID to check your rental application status.
            </p>

            <form asp-area=""
                  asp-controller="Tracker"
                  asp-action="CheckStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label fw-bold text-navy">Application Reference ID</label>
               
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted" style="background-color: var(--bg-light) !important;">
                            <i class="bi bi-hash"></i>
                        </span>
                        <input type="number"
                               name="applicationId"
                               class="form-control border-start-0 ps-0"
                               placeholder="Enter Id"
                               required />
                    </div>
                </div>

               
                <button type="submit" class="btn btn-navy w-100 py-2 shadow-sm fw-semibold">
                    Check Application Status
                </button>
            </form>

            @if (ViewBag.Status != null)
            {
               
                <div class="alert alert-info mt-4 text-center border-0 shadow-sm p-3 d-flex align-items-center justify-content-center gap-2" style="background-color: var(--bg-light); color: var(--navy-blue);">
                    <i class="bi bi-info-circle-fill"></i>
                    <div><strong>Status:</strong> @ViewBag.Status</div>
                </div>
            }
        </div>
    </div>
</div>