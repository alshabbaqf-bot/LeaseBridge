@model LeaseBridge.MVC.Models.MaintenanceLookup.MaintenanceLookupViewModel

@{
    ViewData["Title"] = "Public Maintenance Lookup";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card-custom mb-4">
        <div class="card-header-navy text-center">
            <h4 class="mb-0 fw-bold">Public Maintenance Lookup</h4>
        </div>

        <div class="card-body p-4">
            <p class="text-muted text-center">
                Enter your maintenance ticket number and registered phone number to view your request status.
            </p>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-area=""
                  asp-controller="MaintenanceLookup"
                  asp-action="CheckStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="TicketNumber" class="form-label fw-bold text-navy"></label>
                        <input asp-for="TicketNumber"
                               class="form-control"
                               placeholder="Enter Ticket Number" />
                        <span asp-validation-for="TicketNumber" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label fw-bold text-navy"></label>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="Enter Phone Number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-navy mt-4 w-100">
                    Check Maintenance Status
                </button>
            </form>
        </div>
    </div>

    @if (Model.Result != null)
    {
        <div class="card-custom mb-4">
            <div class="card-header-navy text-center" style="background-color: var(--light-blue);">
                <h5 class="mb-0 text-white fw-bold">Maintenance Request Details</h5>
            </div>

            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-navy fw-bold mb-3">Ticket Number</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.TicketNumber</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Tenant</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.TenantName</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Property</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.PropertyName</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Unit</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.UnitNumber</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Title</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.Title</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Description</dt>
                    <dd class="col-sm-8 mb-3">@(Model.Result.Description ?? "No description provided.")</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Category</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.CategoryName</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Priority</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.PriorityName</dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Current Status</dt>
                    <dd class="col-sm-8 mb-3">
                        @if (Model.Result.StatusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                                            Model.Result.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success px-3 py-2">@Model.Result.StatusName</span>
                        }
                        else if (Model.Result.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">@Model.Result.StatusName</span>
                        }
                        else
                        {
                            <span class="badge px-3 py-2" style="background-color: var(--navy-blue); color: var(--white);">@Model.Result.StatusName</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-navy fw-bold mb-3">Submitted At</dt>
                    <dd class="col-sm-8 mb-3">@Model.Result.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                </dl>

                <hr class="my-4" style="color: var(--pop-color);" />

                <h5 class="text-navy fw-bold mb-3">Update History</h5>

                @if (Model.Result.Updates == null || !Model.Result.Updates.Any())
                {
                    <div class="alert alert-info border-0 shadow-sm" style="background-color: var(--bg-light); color: var(--navy-blue);">
                        No updates have been added yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-header-custom">
                                <tr>
                                    <th>Date</th>
                                    <th>Old Status</th>
                                    <th>New Status</th>
                                    <th>Updated By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var update in Model.Result.Updates)
                                {
                                    <tr>
                                        <td class="fw-semibold">@update.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        <td><span class="badge bg-secondary text-white opacity-75">@update.OldStatusName</span></td>
                                        <td><span class="badge bg-info text-white">@update.NewStatusName</span></td>
                                        <td>@update.UpdatedByName</td>
                                        <td class="text-muted">@update.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}