<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LeaseBridge</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeaseBridge.MVC.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-3">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    LEASE BRIDGE
                </a>

                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="navbar-collapse collapse">

                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Home" asp-action="Index">  Home </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="PublicUnits" asp-action="Index"> Browse Units </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Tracker" asp-action="Index">  Track Application   </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="MaintenanceLookup" asp-action="Index"> Track Maintenance</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Home" asp-action="About">  About  </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Tenant"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle custom-nav-link"
                                       href="#"
                                       id="tenantDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Tenant
                                    </a>


                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="tenantDropdown">
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Tenant Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="AvailableUnits"
                                               asp-action="Index">
                                                Available Units
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Application"
                                               asp-action="MyApplications">
                                                My Applications
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Maintenance"
                                               asp-action="MyRequests">
                                                My Maintenance
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Maintenance"
                                               asp-action="RaiseTicket">
                                                Raise Maintenance Ticket
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Payment"
                                               asp-action="MyPayments">
                                                My Payments
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Tenant"
                                               asp-controller="Notifications"
                                               asp-action="Index">
                                                My Notifications
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Manager") )
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle custom-nav-link"
                                       href="#"
                                       id="managementDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Management
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="managementDropdown">
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="Dashboard"
                                               asp-action="Index">
                                                Dashboard / Approvals
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="MaintenanceManagement"
                                               asp-action="Dashboard">
                                                Maintenance Requests
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="PaymentsManagement"
                                               asp-action="Index">
                                                Payments
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="Notifications"
                                               asp-action="Index">
                                                Notifications
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="LeaseManagement"
                                               asp-action="Index">
                                                Lease Management
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Management"
                                               asp-controller="StaffManagement"
                                               asp-action="Index">
                                                Staff Management
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Staff"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle custom-nav-link"
                                       href="#"
                                       id="staffDropdown"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        Staff
                                    </a>

                                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="staffDropdown">
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Staff"
                                               asp-controller="Home"
                                               asp-action="Index">
                                                Staff Dashboard
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Staff"
                                               asp-controller="MaintenanceTasks"
                                               asp-action="MyTasks">
                                                My Assigned Tasks
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2"
                                               asp-area="Staff"
                                               asp-controller="Notifications"
                                               asp-action="Index">
                                                My Notifications
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link fw-semibold text-navy px-3">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-area=""
                                      asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="btn btn-link nav-link custom-nav-link text-danger">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link custom-nav-link px-3"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-navy px-3 py-2"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="page-container container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <partial name="_Footer" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>