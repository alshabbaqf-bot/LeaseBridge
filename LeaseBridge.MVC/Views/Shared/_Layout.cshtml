<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeaseBridge</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LeaseBridge.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom mb-3 py-3">
            <div class="container-fluid px-4">

                <a class="navbar-brand text-uppercase d-inline-block text-nowrap" href="/"
                   style="color: var(--navy-blue) !important; font-weight: 800; letter-spacing: 1.5px; font-size: 1.25rem;">
                    LEASE BRIDGE
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Flex container to align centered links and components -->
                <div class="navbar-collapse collapse d-sm-flex align-items-center w-100">

                    <!-- Centered Menu Items via mx-auto -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="PublicUnits" asp-action="Index">Browse Units</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" href="/Tracker">Track Application</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle custom-nav-link" href="#" id="tenantDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Tenant
                            </a>
                            <ul class="dropdown-menu shadow-sm border-0" aria-labelledby="tenantDropdown">
                                <li><a class="dropdown-item py-2" href="/Tenant/Home/Index">Tenant Dashboard</a></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/AvailableUnits/Index">Available Units</a></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/Application/MyApplications">My Applications</a></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/Maintenance/MyRequests">My Maintenance</a></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/Maintenance/RaiseTicket">Raise Maintenance Ticket</a></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/Payment/MyPayments">My Payments</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" href="/Tenant/Notifications/Index">My Notifications</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle custom-nav-link" href="#" id="managementDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Management
                            </a>
                            <ul class="dropdown-menu shadow-sm border-0" aria-labelledby="managementDropdown">
                                <li><a class="dropdown-item py-2" href="/Management/Dashboard/Index">Dashboard / Approvals</a></li>
                                <li><a class="dropdown-item py-2" href="/Management/MaintenanceManagement/Dashboard">Maintenance Requests</a></li>
                                <li><a class="dropdown-item py-2" href="/Management/PaymentsManagement/Index">Payments</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2" href="/Management/Notifications/Index">Notifications</a></li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Authentication Layout Block -->
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>