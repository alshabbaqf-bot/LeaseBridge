@model LeaseBridge.API.Models.Unit

@{
    ViewData["Title"] = "Unit Details";

    var applyReturnUrl = Url.Action(
        action: "Apply",
        controller: "Application",
        values: new { area = "Tenant", unitId = Model.UnitId });
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="card-custom shadow-sm">
        <!-- Header text centered with text-center class -->
        <div class="card-header-navy text-center">
            <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Unit @Model.UnitNumber Details</h4>
        </div>

        <div class="card-body p-4">
            <dl class="row mb-0 align-items-center">
                <dt class="col-sm-4 text-navy fw-bold mb-3">Property</dt>
                <dd class="col-sm-8 mb-3 text-dark">
                    <i class="bi bi-building me-1 text-muted"></i> @(Model.Property?.Name ?? "N/A")
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Unit Number</dt>
                <dd class="col-sm-8 mb-3 text-dark fw-semibold">@Model.UnitNumber</dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Size</dt>
                <dd class="col-sm-8 mb-3 text-dark">
                    <i class="bi bi-ruler me-1 text-muted"></i> @Model.Size sqft
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Monthly Rent</dt>
                <dd class="col-sm-8 mb-3 text-dark fw-bold fs-5">
                    @Model.RentAmount.ToString("0.000") BHD <small class="text-muted fs-6 fw-normal">/ month</small>
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Status</dt>
                <dd class="col-sm-8 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <!-- Redundant badge element removed; keeping only the custom action-styled status pill button layout -->
                        @if (Model.Status == null || Model.Status.Name == "Available")
                        {
                            <button type="button" class="btn btn-success btn-sm px-3 rounded-pill shadow-sm" style="font-size: 0.85rem; pointer-events: none;" disabled>
                                <i class="bi bi-check-circle me-1"></i> Available
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-sm px-3 rounded-pill shadow-sm" style="font-size: 0.85rem; pointer-events: none;" disabled>
                                @Model.Status.Name
                            </button>
                        }
                    </div>
                </dd>
            </dl>

            <hr class="my-4" style="color: var(--pop-color); opacity: 0.2;" />

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-4">
                <div>
                    <a asp-area=""
                       asp-controller="PublicUnits"
                       asp-action="Index"
                       class="btn btn-outline-navy px-4 py-2">
                        <i class="bi bi-arrow-left me-1"></i> Back to Available Units
                    </a>
                </div>

                <div>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Tenant"
                           asp-controller="Application"
                           asp-action="Apply"
                           asp-route-unitId="@Model.UnitId"
                           class="btn btn-navy px-4 py-2">
                            <i class="bi bi-file-earmark-plus me-1"></i> Apply for this Unit
                        </a>
                    }
                    else
                    {
                        <a asp-area=""
                           asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@applyReturnUrl"
                           class="btn btn-navy px-4 py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Apply for this Unit
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>