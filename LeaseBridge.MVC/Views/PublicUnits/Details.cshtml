@model LeaseBridge.API.Models.Unit
@{
    ViewData["Title"] = "Property Specifications";
}

<div class="container mt-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <!-- FIX: Added explicit root area escape logic to breadcrumbs -->
            <li class="breadcrumb-item"><a asp-area="" asp-controller="PublicUnits" asp-action="Index" class="text-decoration-none text-navy fw-semibold">Marketplace</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">Unit Details</li>
        </ol>
    </nav>

    <div class="row bg-white p-4 p-md-5 rounded shadow-lg border-0 g-4 mt-1" style="border-radius: 20px !important;">
        <div class="col-md-7 pe-md-4">
            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-bold mb-3"><i class="bi bi-check-circle-fill me-1"></i> Ready for Immediate Move-in</span>
            <h1 class="text-dark fw-bold mb-1" style="letter-spacing: -0.5px;">Apartment Suite @Model.UnitNumber</h1>
            <h3 class="text-secondary fw-semibold mb-3" style="font-size: 1.30rem;">@Model.Property?.Name</h3>
            <p class="text-muted fs-6 mb-4"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Property?.Location</p>

            <h5 class="fw-bold text-navy mt-4 mb-2" style="color: var(--navy-blue);">About this Property</h5>
            <p class="text-secondary border-start border-3 ps-3 py-2 bg-light rounded-end" style="border-color: var(--navy-blue) !important; font-size: 0.95rem; line-height: 1.6;">
                @(string.IsNullOrEmpty(Model.Property?.Description) ? "No structural notes or specific descriptive items provided for this building profile listing layout." : Model.Property.Description)
            </p>
        </div>

        <div class="col-md-5">
            <div class="bg-light p-4 rounded border-0 text-center shadow-sm" style="border-radius: 18px !important;">
                <span class="text-muted d-block small mb-1 text-uppercase fw-bold tracking-wider" style="font-size: 0.7rem; letter-spacing: 0.5px;">Guaranteed Fixed Pricing</span>
                <h1 class="text-success fw-bold display-6 mb-3">@Model.RentAmount <span class="fs-3 fw-semibold">BHD</span> <span class="fs-6 fw-normal text-muted d-block mt-1">per calendar month</span></h1>

                <ul class="list-group list-group-flush text-start rounded mb-4 border-0 shadow-sm" style="overflow: hidden; border-radius: 12px;">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small"><i class="bi bi-ruler me-2" style="color: var(--navy-blue);"></i> Total Area Size</span>
                        <strong class="text-dark">@Model.Size Sq Ft</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small"><i class="bi bi-hash me-2" style="color: var(--navy-blue);"></i> Unique Unit Index</span>
                        <strong class="text-dark">#@Model.UnitId</strong>
                    </li>
                </ul>

                <!-- NOTE: Keeps asp-area="Tenant" as this correctly points to the applying process zone -->
                <a asp-area="Tenant" asp-controller="Application" asp-action="Apply" asp-route-unitId="@Model.UnitId" class="btn btn-navy btn-lg w-100 fw-bold mb-2 shadow-sm py-2.5" style="border-radius: 10px; font-size: 1rem;">
                    <i class="bi bi-file-earmark-arrow-up-fill me-1"></i> Apply for Lease Online
                </a>

                <!-- FIX: Added asp-area="" fallback context -->
                <a asp-area="" asp-controller="PublicUnits" asp-action="Index" class="btn btn-link w-100 text-muted btn-sm text-decoration-none mt-2">Return to Listings Marketplace</a>
            </div>
        </div>
    </div>
</div>