@model IEnumerable<LeaseBridge.API.Models.Unit>

@{
    ViewData["Title"] = "Browse Units";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="text-navy fw-bold">Available Rental Units</h2>
        <p class="text-muted">
            Browse top-tier listings across premier locations.
        </p>
    </div>

    <form asp-area=""
          asp-controller="PublicUnits"
          asp-action="Index"
          method="get"
          class="row g-2 mb-5">

        <div class="col-md-10">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control form-control-lg border-2 shadow-sm"
                   style="border-color: var(--light-blue);"
                   placeholder="Search by unit number or property name..." />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-navy btn-lg w-100 shadow-sm fw-semibold">
                <i class="bi bi-search me-1"></i> Search
            </button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center border-0 shadow-sm p-4" style="background-color: var(--bg-light); color: var(--navy-blue);">
            <i class="bi bi-exclamation-circle fs-4 d-block mb-2"></i>
            No available rental units match your search.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var unit in Model)
            {
                var applyReturnUrl = Url.Action(
                action: "Apply",
                controller: "Application",
                values: new { area = "Tenant", unitId = unit.UnitId });

                <div class="col-md-4 mb-2">
                    <div class="card-custom h-100 shadow-sm d-flex flex-column justify-content-between">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-navy fw-bold mb-0">Unit @unit.UnitNumber</h5>

                                @if (unit.Status == null || unit.Status.Name == "Available")
                                {
                                    <button type="button" class="btn btn-success btn-sm px-3 rounded-pill shadow-sm" style="font-size: 0.8rem; pointer-events: none;" disabled>
                                        <i class="bi bi-check-circle me-1"></i> Available
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary btn-sm px-3 rounded-pill shadow-sm" style="font-size: 0.8rem; pointer-events: none;" disabled>
                                        @unit.Status.Name
                                    </button>
                                }
                            </div>

                            <h6 class="card-subtitle mb-4 text-muted">
                                <i class="bi bi-building me-1"></i> @(unit.Property?.Name ?? "Property not specified")
                            </h6>

                            <div class="bg-light p-3 rounded mb-4" style="background-color: var(--bg-light) !important;">
                                <p class="card-text mb-0 text-dark">
                                    <i class="bi bi-ruler me-2 text-navy"></i><strong>Size:</strong> @unit.Size sqft
                                </p>
                                <p class="card-text mb-0 text-dark mt-2">
                                    <i class="bi bi-info-circle me-2 text-navy"></i><strong>Status:</strong> @(unit.Status?.Name ?? "Available")
                                </p>
                            </div>

                            <hr style="color: var(--pop-color); opacity: 0.2;" />

                            <div class="my-3">
                                <h4 class="fw-bold text-navy mb-0">
                                    @unit.RentAmount.ToString("0.000") BHD
                                    <small class="text-muted fs-6 fw-normal">/ month</small>
                                </h4>
                            </div>
                        </div>

                        <div class="p-4 pt-0 bg-transparent border-top-0 d-flex gap-2">
                            <a asp-area=""
                               asp-controller="PublicUnits"
                               asp-action="Details"
                               asp-route-id="@unit.UnitId"
                               class="btn btn-outline-navy flex-fill fw-semibold py-2">
                                <i class="bi bi-eye me-1"></i> View Details
                            </a>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <a asp-area="Tenant"
                                   asp-controller="Application"
                                   asp-action="Apply"
                                   asp-route-unitId="@unit.UnitId"
                                   class="btn btn-navy flex-fill fw-semibold py-2">
                                    <i class="bi bi-file-earmark-plus me-1"></i> Apply
                                </a>
                            }
                            else
                            {
                                <a asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login"
                                   asp-route-returnUrl="@applyReturnUrl"
                                   class="btn btn-navy flex-fill fw-semibold py-2">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Apply
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>