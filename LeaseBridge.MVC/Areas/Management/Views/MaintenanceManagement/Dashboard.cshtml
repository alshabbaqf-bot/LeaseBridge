@model IEnumerable<LeaseBridge.MVC.Areas.Management.Controllers.ManagementTicketViewModel>

@{
    ViewData["Title"] = "Property Manager Maintenance Console";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                Review incoming maintenance requests, track priorities, and update ticket workflow status.
            </p>
        </div>
    </div>

    <!-- Card -->
    <div class="card card-custom shadow-sm border-0 overflow-hidden">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <!-- HEADER (same system as invoices) -->
                <thead class="table-header-custom text-white">
                    <tr>
                        <th class="p-3">Ticket</th>
                        <th class="p-3">Tenant / Unit</th>
                        <th class="p-3">Issue Details</th>
                        <th class="p-3">Priority</th>
                        <th class="p-3">Current Status</th>
                        <th class="p-3 text-center">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-5 text-muted">
                                No requests found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Ticket -->
                                <td class="p-3 fw-bold text-navy">
                                    @item.TicketNumber
                                </td>

                                <!-- Tenant / Unit -->
                                <td class="p-3">
                                    <div class="fw-semibold">@item.TenantName</div>
                                    <small class="badge bg-light text-dark border">
                                        Unit @item.UnitName
                                    </small>
                                </td>

                                <!-- Issue -->
                                <td class="p-3">
                                    <div class="fw-semibold">@item.Title</div>
                                    <small class="text-muted">
                                        Type: @item.CategoryName
                                    </small>
                                </td>

                                <!-- Priority -->
                                <td class="p-3">
                                    @if (item.PriorityName?.ToLower() == "high")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3">
                                            @item.PriorityName
                                        </span>
                                    }
                                    else if (item.PriorityName?.ToLower() == "medium")
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                            @item.PriorityName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">
                                            @item.PriorityName
                                        </span>
                                    }
                                </td>

                                <!-- Status -->
                                <td class="p-3">
                                    <span class="badge bg-info-subtle text-info rounded-pill px-3">
                                        @item.StatusName
                                    </span>
                                </td>

                                <!-- Action -->
                                <td class="p-3 text-center">
                                    <a asp-action="ProcessTicket"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-navy rounded-pill px-3 shadow-sm">
                                        Manage
                                    </a>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>
    </div>
</div>