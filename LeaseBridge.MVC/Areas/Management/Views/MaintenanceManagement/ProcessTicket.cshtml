@model LeaseBridge.API.Models.MaintenanceRequest

@{
    ViewData["Title"] = "Process Maintenance Request";
}

<div class="container mt-5 mb-5" style="max-width: 650px;">

    <div class="card card-custom shadow border-0">
        <div class="card-header card-header-navy py-4">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-gear-fill me-2"></i>
                Process Maintenance Request
            </h5>
            <small class="text-white-50">Ticket Number: @Model.TicketNumber</small>
        </div>

        <div class="card-body p-4 bg-light">
            <div class="p-4 bg-white border rounded mb-4" style="box-shadow: var(--shadow-sm);">
                <label class="small fw-bold text-uppercase text-muted mb-2">Tenant Reported Issue</label>
                <p class="mb-3 text-dark fs-6 @(string.IsNullOrEmpty(Model.Description) ? "text-muted" : "")">
                    @(Model.Description ?? "No text description provided by tenant.")
                </p>

                <div class="pt-3 border-top d-flex align-items-center">
                    <i class="bi bi-clock-history text-muted me-2"></i>
                    <small class="text-muted">Logged: @Model.CreatedAt.ToString("g")</small>
                </div>
            </div>

            @if (TempData["ManagementError"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">
                    @TempData["ManagementError"]
                </div>
            }

            <form asp-area="Management"
                  asp-controller="MaintenanceManagement"
                  asp-action="ProcessTicket"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.RequestId" />

                <div class="mb-4">
                    <label class="form-label fw-bold text-navy">
                        Update Maintenance Status
                    </label>

                    <select name="statusId" class="form-select modern-input shadow-sm py-2" required>
                        @foreach (var status in ViewBag.Statuses)
                        {
                            <option value="@status.StatusId" selected="@(status.StatusId == Model.StatusId)">
                                @status.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="row g-3 pt-2">
                    <div class="col-6">
                        <a asp-area="Management"
                           asp-controller="MaintenanceManagement"
                           asp-action="Dashboard"
                           class="btn btn-outline-secondary w-100 fw-bold py-2">
                            Return
                        </a>
                    </div>

                    <div class="col-6">
                        <button type="submit" class="btn btn-navy w-100 fw-bold shadow-sm py-2">
                            Save Changes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>