@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="container mt-5" style="max-width: 850px;">
    <div class="card shadow-sm border-0 overflow-hidden rounded-3 mb-5">

        <div class="py-3 px-4 d-flex align-items-center justify-content-between text-white" style="background-color: #0d346d !important;">
            <div>
                <h5 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: inherit;">
                    <i class="bi bi-pencil-square text-warning"></i> Edit Invoice
                </h5>
                <small class="text-white-50 opacity-75 d-block mt-0.5" style="font-size: 0.8rem;">Modify parameters for the selected ledger record</small>
            </div>
            <span class="badge bg-white text-dark font-monospace fw-bold px-2.5 py-1.5 border-0 shadow-sm" style="font-size: 0.85rem;">
                #@Model.InvoiceNumber
            </span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <form asp-area="Management"
                  asp-controller="PaymentsManagement"
                  asp-action="Edit"
                  asp-route-id="@Model.InvoiceId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm p-3 mb-4 rounded-3" style="background-color: #fde8e8;">
                    <div class="d-flex align-items-start gap-2.5">
                        <i class="bi bi-exclamation-octagon-fill fs-5 mt-0.5" style="color: #c81e1e;"></i>
                        <div>
                            <span class="fw-bold d-block mb-1 text-danger-emphasis" style="color: #9b1c1c !important;">Please review the following configuration parameters:</span>
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-white border border-light-subtle rounded-3 shadow-sm mb-4">
                    <div class="row g-4">

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1 small text-uppercase font-monospace tracking-wider text-secondary" style="font-size: 0.75rem;">Lease Assignment</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                </span>
                                <select name="leaseId"
                                        class="form-select border-start-0 ps-1 shadow-sm text-dark fw-medium"
                                        asp-items="ViewBag.LeaseId"
                                        required>
                                    <option value="">-- Select Lease --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1 small text-uppercase font-monospace tracking-wider text-secondary" style="font-size: 0.75rem;">Invoice Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input name="invoiceNumber"
                                       class="form-control border-start-0 ps-1 shadow-sm font-monospace fw-semibold text-dark"
                                       value="@Model.InvoiceNumber"
                                       required />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1 small text-uppercase font-monospace tracking-wider text-secondary" style="font-size: 0.75rem;">Billing Amount</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-cash-stack"></i>
                                </span>
                                <input name="amount"
                                       type="number"
                                       step="0.001"
                                       min="0.001"
                                       class="form-control border-start-0 border-end-0 ps-1 font-monospace fw-bold text-dark fs-6"
                                       value="@Model.Amount"
                                       required />
                                <span class="input-group-text bg-light text-secondary small fw-bold font-monospace px-3" style="font-size: 0.8rem;">BHD</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1 small text-uppercase font-monospace tracking-wider text-secondary" style="font-size: 0.75rem;">Issued Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-calendar-check"></i>
                                </span>
                                <input name="issuedDate"
                                       type="date"
                                       class="form-control border-start-0 ps-1 shadow-sm text-secondary font-monospace fw-medium"
                                       value="@Model.IssuedDate.ToString("yyyy-MM-dd")"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1 small text-uppercase font-monospace tracking-wider text-secondary" style="font-size: 0.75rem;">Due Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-calendar-x"></i>
                                </span>
                                <input name="dueDate"
                                       type="date"
                                       class="form-control border-start-0 ps-1 shadow-sm text-dark font-monospace fw-bold"
                                       value="@Model.DueDate.ToString("yyyy-MM-dd")"
                                       required />
                            </div>
                        </div>

                    </div>
                </div>

                <div class="alert alert-info border-0 bg-white shadow-sm rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center p-2.5 shadow-sm mt-0.5" style="background-color: #e1f5fe; color: #03a9f4;">
                            <i class="bi bi-gear-fill fs-5"></i>
                        </div>
                        <div class="small text-secondary lh-base">
                            Invoice status is managed automatically by the application ecosystem. Unpaid records resolve to <strong>Pending</strong> or <strong>Overdue</strong> based on the operational timeline thresholds, while processed settlements retain a strict <strong>Paid</strong> designation state.
                        </div>
                    </div>
                </div>

                <div class="row g-3 pt-3 border-top mt-2 align-items-center">
                    <div class="col-6 col-md-4 order-md-1">
                        <a asp-area="Management"
                           asp-controller="PaymentsManagement"
                           asp-action="Index"
                           class="btn w-100 fw-semibold py-2 btn-sm d-inline-flex align-items-center justify-content-center gap-1 shadow-sm bg-white"
                           style="border: 1px solid #ced4da !important; color: #495057 !important;">
                            Cancel
                        </a>
                    </div>

                    <div class="col-6 col-md-4 order-md-2">
                        <a asp-area="Management"
                           asp-controller="PaymentsManagement"
                           asp-action="Details"
                           asp-route-id="@Model.InvoiceId"
                           class="btn w-100 fw-semibold py-2 btn-sm d-inline-flex align-items-center justify-content-center gap-1 shadow-sm bg-white"
                           style="border: 1px solid #0d346d !important; color: #0d346d !important;">
                            View Details
                        </a>
                    </div>

                    <div class="col-md-4 ms-md-auto order-md-3">
                        <button type="submit" class="btn w-100 fw-bold py-2 btn-sm d-inline-flex align-items-center justify-content-center gap-1 shadow-sm text-white"
                                style="background-color: #0d346d !important; border-color: #0d346d !important;">
                            Save Changes
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>