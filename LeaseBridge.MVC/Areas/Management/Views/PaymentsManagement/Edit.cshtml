@model LeaseBridge.API.Models.Payment

@{
    ViewData["Title"] = "Edit Payment";
}

<div class="container mt-4" style="max-width: 750px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Edit Payment</h4>
        </div>

        <div class="card-body">
            <form asp-area="Management"
                  asp-controller="PaymentsManagement"
                  asp-action="Edit"
                  asp-route-id="@Model.PaymentId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="PaymentId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="LeaseId" class="form-label fw-bold">Lease</label>
                    <select asp-for="LeaseId"
                            class="form-select"
                            asp-items="ViewBag.LeaseId">
                        <option value="">-- Select Lease --</option>
                    </select>
                    <span asp-validation-for="LeaseId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                    <div class="input-group">
                        <input asp-for="Amount" class="form-control" />
                        <span class="input-group-text">BHD</span>
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DueDate" class="form-label fw-bold">Due Date</label>
                    <input asp-for="DueDate" type="date" class="form-control" />
                    <span asp-validation-for="DueDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentDate" class="form-label fw-bold">Payment Date</label>
                    <input asp-for="PaymentDate" type="date" class="form-control" />
                    <small class="text-muted">Leave empty if the payment has not been received yet.</small>
                    <span asp-validation-for="PaymentDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MethodId" class="form-label fw-bold">Payment Method</label>
                    <select asp-for="MethodId"
                            class="form-select"
                            asp-items="ViewBag.MethodId">
                        <option value="">-- Select Method --</option>
                    </select>
                    <span asp-validation-for="MethodId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StatusId" class="form-label fw-bold">Payment Status</label>
                    <select asp-for="StatusId"
                            class="form-select"
                            asp-items="ViewBag.StatusId">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        Save Changes
                    </button>

                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Details"
                       asp-route-id="@Model.PaymentId"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}