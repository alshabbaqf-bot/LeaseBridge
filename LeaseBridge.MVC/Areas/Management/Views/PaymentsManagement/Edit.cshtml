@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Edit Invoice";
}

<div class="container mt-5">
    <div class="card shadow border-0 overflow-hidden rounded-3">

        <div class="card-header bg-dark py-3 px-4 d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-pencil-square text-warning"></i> Edit Invoice
                </h5>
                <small class="text-white-50 opacity-75 d-block mt-0.5">Modify parameters for the selected ledger record</small>
            </div>
            <span class="badge bg-warning text-dark font-monospace fw-bold px-2.5 py-1.5 rounded">
                #@Model.InvoiceNumber
            </span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <form asp-area="Management"
                  asp-controller="PaymentsManagement"
                  asp-action="Edit"
                  asp-route-id="@Model.InvoiceId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger border-0 shadow-sm small p-3 mb-4">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-5 mt-0.5 text-danger"></i>
                        <div>
                            <span class="fw-bold d-block mb-1">Please review the following configuration parameters:</span>
                        </div>
                    </div>
                </div>

                <div class="p-4 bg-white border rounded shadow-sm mb-4">
                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Lease Assignment</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                </span>
                                <select name="leaseId"
                                        class="form-select border-start-0 ps-1 shadow-sm"
                                        asp-items="ViewBag.LeaseId"
                                        required>
                                    <option value="">-- Select Lease --</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Invoice Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input name="invoiceNumber"
                                       class="form-control border-start-0 ps-1 shadow-sm font-monospace fw-semibold"
                                       value="@Model.InvoiceNumber"
                                       required />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Billing Amount</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-cash-stack"></i>
                                </span>
                                <input name="amount"
                                       type="number"
                                       step="0.001"
                                       min="0.001"
                                       class="form-control border-start-0 border-end-0 ps-1 font-monospace fw-bold text-dark fs-6"
                                       value="@Model.Amount"
                                       required />
                                <span class="input-group-text bg-light text-secondary small fw-bold font-monospace px-3">BHD</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1.5">Issued Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-calendar-check"></i>
                                </span>
                                <input name="issuedDate"
                                       type="date"
                                       class="form-control border-start-0 ps-1 shadow-sm text-secondary small fw-medium"
                                       value="@Model.IssuedDate.ToString("yyyy-MM-dd")"
                                       required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1.5">Due Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-calendar-x"></i>
                                </span>
                                <input name="dueDate"
                                       type="date"
                                       class="form-control border-start-0 ps-1 shadow-sm text-dark small 'fw-bold'"
                                       value="@Model.DueDate.ToString("yyyy-MM-dd")"
                                       required />
                            </div>
                        </div>

                    </div>
                </div>

                <div class="alert alert-info border-0 bg-white shadow-sm rounded-3 p-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center p-2.5 shadow-sm mt-0.5">
                            <i class="bi bi-gear-fill fs-5"></i>
                        </div>
                        <div class="small text-secondary lh-base">
                            Invoice status is managed automatically by the application ecosystem. Unpaid records resolve to <strong>Pending</strong> or <strong>Overdue</strong> based on the operational timeline thresholds, while processed settlements retain a strict <strong>Paid</strong> designation state.
                        </div>
                    </div>
                </div>

                <div class="row g-3 pt-3 border-top mt-2">
                    <div class="col-md-4 order-md-3">
                        <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2 d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-check-circle-fill"></i> Save Changes
                        </button>
                    </div>

                    <div class="col-6 col-md-4 order-md-2">
                        <a asp-area="Management"
                           asp-controller="PaymentsManagement"
                           asp-action="Details"
                           asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-info w-100 fw-semibold py-2 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-info-circle"></i> View Details
                        </a>
                    </div>

                    <div class="col-6 col-md-4 order-md-1">
                        <a asp-area="Management"
                           asp-controller="PaymentsManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 fw-semibold py-2 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-arrow-left"></i> Cancel & Back
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>