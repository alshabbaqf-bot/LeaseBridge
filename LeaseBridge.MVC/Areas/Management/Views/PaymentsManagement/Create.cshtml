@{
    ViewData["Title"] = "Add Invoice";
}

<div class="container mt-5" style="max-width: 750px;">
    <!-- Modernized Custom Card Design Layout -->
    <div class="card shadow border-0 overflow-hidden rounded-3">
        <!-- Main Panel Header -->
        <div class="card-header bg-dark py-3 px-4 d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-plus-fill text-primary"></i> Add Invoice
                </h5>
                <small class="text-white-50 opacity-75 d-block mt-0.5">Generate a new billing entry for the ledger</small>
            </div>
            <span class="badge bg-primary text-white fw-bold px-2.5 py-1.5 fs-7 rounded">NEW RECORD</span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <form asp-area="Management"
                  asp-controller="PaymentsManagement"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Operational Validation Error Block Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm small p-3 mb-4" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-octagon-fill fs-5 mt-0.5"></i>
                        <div>
                            <span class="fw-bold d-block mb-1">Please correct the following model errors:</span>
                        </div>
                    </div>
                </div>

                <!-- Input Elements Container Box -->
                <div class="p-4 bg-white border rounded shadow-sm mb-4">
                    <div class="row g-3">
                        <!-- Lease Reference Selector Component -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Lease Assignment</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-file-earmark-text-fill"></i>
                                </span>
                                <select name="leaseId" class="form-select border-start-0 ps-1 shadow-sm" asp-items="ViewBag.LeaseId" required>
                                    <option value="">-- Select Lease --</option>
                                </select>
                            </div>
                        </div>

                        <!-- Invoice String Identifier Input Component -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Invoice Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-hash"></i>
                                </span>
                                <input name="invoiceNumber"
                                       class="form-control border-start-0 ps-1 shadow-sm font-monospace fw-semibold"
                                       placeholder="Example: INV-2026-001"
                                       required />
                            </div>
                        </div>

                        <!-- Accounting Ledger Value Input Component -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark mb-1.5">Billing Amount</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-cash-stack"></i>
                                </span>
                                <input name="amount"
                                       type="number"
                                       step="0.001"
                                       min="0.001"
                                       class="form-control border-start-0 border-end-0 ps-1 font-monospace fw-bold text-dark fs-6"
                                       placeholder="0.000"
                                       required />
                                <span class="input-group-text bg-light text-secondary small fw-bold font-monospace px-3">BHD</span>
                            </div>
                        </div>

                        <!-- Temporary Timeline Threshold Parameters Matrix -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1.5">Issued Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-calendar-check"></i>
                                </span>
                                <input name="issuedDate" type="date" class="form-control border-start-0 ps-1 shadow-sm text-secondary small fw-medium" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark mb-1.5">Due Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-secondary border-end-0">
                                    <i class="bi bi-calendar-x"></i>
                                </span>
                                <input name="dueDate" type="date" class="form-control border-start-0 ps-1 shadow-sm text-dark small fw-bold" required />
                            </div>
                        </div>
                    </div>
                </div>

                @* <div class="mb-3">
                    <label class="form-label fw-bold">Invoice Status</label>
                    <select name="statusId" class="form-select" asp-items="ViewBag.StatusId" required>
                        <option value="">-- Select Status --</option>
                    </select>
                </div> *@

                <!-- Balanced Interaction Controls Layout -->
                <div class="row g-3 pt-2">
                    <div class="col-sm-6 order-sm-2">
                        <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2 d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-cloud-arrow-up-fill"></i> Save Invoice
                        </button>
                    </div>

                    <div class="col-sm-6 order-sm-1">
                        <a asp-area="Management"
                           asp-controller="PaymentsManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 fw-semibold py-2 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-arrow-left"></i> Back to Ledger
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>