@model IEnumerable<LeaseBridge.API.Models.Invoice>

@{
    ViewData["Title"] = ViewBag.IsOverduePage == true ? "Overdue Invoices" : "Payments Management";
}

<div class="container page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-navy fw-bold mb-1">@ViewData["Title"]</h2>
            <p class="text-muted small mb-0">
                @(ViewBag.IsOverduePage == true
                                ? "View unpaid invoices that are overdue."
                                : "Manage tenant invoices, payment records, and overdue balances.")
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="Management"
               asp-controller="PaymentsManagement"
               asp-action="Create"
               class="btn btn-navy shadow-sm">
                Add Invoice
            </a>

            @if (ViewBag.IsOverduePage == true)
            {
                <a asp-area="Management"
                   asp-controller="PaymentsManagement"
                   asp-action="Index"
                   class="btn btn-secondary shadow-sm">
                    All Invoices
                </a>
            }
            else
            {
                <a asp-area="Management"
                   asp-controller="PaymentsManagement"
                   asp-action="Overdue"
                   class="btn btn-danger shadow-sm">
                    Overdue Invoices
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            No invoice records found.
        </div>
    }
    else
    {
        <div class="card-custom">
            <div class="table-responsive table-min-width">
                <table class="table align-middle mb-0">
                    <thead class="table-header-custom table-header-uppercase">
                        <tr>
                            <th class="ps-4">Invoice</th>
                            <th>Lease</th>
                            <th>Tenant</th>
                            <th>Property / Unit</th>
                            <th>Amount</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Last Payment</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            var latestPayment = invoice.Payments
                            .OrderByDescending(p => p.PaymentDate)
                            .FirstOrDefault();

                            <tr>
                                <td class="fw-bold text-navy ps-4">@invoice.InvoiceNumber</td>
                                <td>Lease #@invoice.LeaseId</td>

                                <td>
                                    @if (invoice.Lease?.Tenant != null)
                                    {
                                        <span class="fw-semibold">@invoice.Lease.Tenant.FirstName @invoice.Lease.Tenant.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted italic">N/A</span>
                                    }
                                </td>

                                <td>
                                    <strong class="text-navy">@(invoice.Lease?.Unit?.Property?.Name ?? "N/A")</strong>
                                    <br />
                                    <small class="text-muted">
                                        Unit @(invoice.Lease?.Unit?.UnitNumber ?? "N/A")
                                    </small>
                                </td>

                                <td class="fw-bold">@invoice.Amount.ToString("0.000") BHD</td>
                                <td>@invoice.DueDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (invoice.Status?.Name == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis px-2.5 py-1.5 rounded">Paid</span>
                                    }
                                    else if (invoice.Status?.Name == "Overdue")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5 rounded">
                                            @(invoice.Status?.Name ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (latestPayment != null)
                                    {
                                        <span class="fw-semibold">@latestPayment.PaymentDate.ToString("dd MMM yyyy")</span>
                                        <br />
                                        <small class="text-muted shadow-none">@latestPayment.Method?.Name</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not Paid</span>
                                    }
                                </td>

                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-area="Management"
                                           asp-controller="PaymentsManagement"
                                           asp-action="Details"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-info-subtle text-info-emphasis btn-sm">
                                            Details
                                        </a>

                                        <a asp-area="Management"
                                           asp-controller="PaymentsManagement"
                                           asp-action="Edit"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-warning-subtle text-warning-emphasis btn-sm">
                                            Edit
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>