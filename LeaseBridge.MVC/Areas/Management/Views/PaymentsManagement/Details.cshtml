@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="page-container d-flex justify-content-center">
    <div class="card card-custom" style="width: 100%; max-width: 850px;">
        <div class="card-header-navy">
            <h4 class="mb-0 fw-bold">Invoice Details: @Model.InvoiceNumber</h4>
        </div>

        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-navy">Tenant</dt>
                        <dd class="col-sm-7 fw-bold">@(Model.Lease?.Tenant != null ? $"{Model.Lease.Tenant.FirstName} {Model.Lease.Tenant.LastName}" : "N/A")</dd>

                        <dt class="col-sm-5 text-navy">Property</dt>
                        <dd class="col-sm-7">@(Model.Lease?.Unit?.Property?.Name ?? "N/A")</dd>

                        <dt class="col-sm-5 text-navy">Unit</dt>
                        <dd class="col-sm-7">@(Model.Lease?.Unit?.UnitNumber ?? "N/A")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-navy">Amount</dt>
                        <dd class="col-sm-7 fw-bold">@Model.Amount.ToString("0.000") BHD</dd>

                        <dt class="col-sm-5 text-navy">Due Date</dt>
                        <dd class="col-sm-7">@Model.DueDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-5 text-navy">Status</dt>
                        <dd class="col-sm-7">
                            @{
                                string bg = Model.Status?.Name == "Paid" ? "bg-success" :
                                Model.Status?.Name == "Overdue" ? "bg-danger" : "bg-warning text-dark";
                            }
                            <span class="badge @bg">@(Model.Status?.Name ?? "Pending")</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <h5 class="fw-bold text-navy mt-4 mb-3">Payment Transactions</h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-header-custom">
                        <tr>
                            <th class="p-3">ID</th>
                            <th class="p-3">Amount</th>
                            <th class="p-3">Date</th>
                            <th class="p-3">Method</th>
                            <th class="p-3">Reference</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Payments.Any())
                        {
                            <tr><td colspan="5" class="text-center p-3 text-muted">No transactions recorded.</td></tr>
                        }
                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                        {
                            <tr>
                                <td class="p-3">@payment.PaymentId</td>
                                <td class="p-3 fw-bold">@payment.Amount.ToString("0.000") BHD</td>
                                <td class="p-3">@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td class="p-3">@(payment.Method?.Name ?? "N/A")</td>
                                <td class="p-3 font-monospace small">@(payment.TransactionReference ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex gap-2 mt-4 align-items-center">
                <a asp-action="Edit" asp-route-id="@Model.InvoiceId" class="btn btn-navy rounded-pill">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.InvoiceId" class="btn btn-outline-danger rounded-pill">Delete</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to List</a>
            </div>

        </div>
    </div>
</div>