@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container mt-5" style="max-width: 850px;">
    <div class="card shadow border-0 overflow-hidden rounded-3">
        <div class="card-header bg-dark py-3 px-4 d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                <i class="bi bi-receipt text-info"></i> Invoice Information
            </h5>
            <span class="badge bg-light text-dark font-monospace fw-bold px-2.5 py-1.5 fs-7 border">
                #@Model.InvoiceNumber
            </span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <div class="bg-white border rounded p-4 shadow-sm mb-4">
                <div class="row g-3">
                    <div class="col-sm-6 border-bottom pb-2">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8">Invoice Number</small>
                        <span class="fw-bold text-dark fs-6">@Model.InvoiceNumber</span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-2">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8">Lease Reference</small>
                        <span class="badge bg-light text-secondary border px-2 py-1 fw-semibold mt-1">
                            <i class="bi bi-file-earmark-text text-muted me-1"></i> Lease #@Model.LeaseId
                        </span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-2">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8">Tenant Name</small>
                        <span class="fw-semibold text-dark">
                            @(Model.Lease?.Tenant != null
                                                        ? Model.Lease.Tenant.FirstName + " " + Model.Lease.Tenant.LastName
                                                        : "N/A")
                        </span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-2">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8">Invoice Status</small>
                        <div class="mt-1">
                            @if (Model.Status?.Name == "Paid")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1">
                                    <span class="p-0.5 bg-success rounded-circle"></span> Paid
                                </span>
                            }
                            else if (Model.Status?.Name == "Overdue")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1">
                                    <span class="p-0.5 bg-danger rounded-circle"></span> Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1">
                                    <span class="p-0.5 bg-warning rounded-circle"></span> @(Model.Status?.Name ?? "Pending")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6 border-bottom border-sm-bottom-0 pb-2 pb-sm-0">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8">Property Allocation</small>
                        <span class="fw-bold text-dark d-block">@(Model.Lease?.Unit?.Property?.Name ?? "N/A")</span>
                        <small class="text-muted">Unit @(Model.Lease?.Unit?.UnitNumber ?? "N/A")</small>
                    </div>

                    <div class="col-sm-6 text-sm-end align-self-center">
                        <small class="text-muted d-block text-uppercase tracking-wider font-monospace fs-8 text-sm-end">Total Grand Amount</small>
                        <span class="font-monospace fw-bold text-navy fs-4 d-block">
                            @Model.Amount.ToString("0.000") <span class="fs-6 text-muted fw-normal">BHD</span>
                        </span>
                    </div>
                </div>

                <div class="row g-3 mt-3 pt-3 border-top bg-light-subtle mx-n4 px-4 rounded-bottom">
                    <div class="col-6">
                        <small class="text-muted d-block small mb-0.5"><i class="bi bi-calendar-check me-1"></i> Issued Date</small>
                        <span class="text-secondary fw-semibold small">@Model.IssuedDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted d-block small mb-0.5"><i class="bi bi-calendar-x me-1"></i> Due Date</small>
                        <span class="text-dark fw-bold small">@Model.DueDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-navy mb-3 mt-4 d-flex align-items-center gap-2 fs-6">
                <i class="bi bi-credit-card-2-back-fill text-secondary"></i> Payment Transactions History
            </h5>

            @if (!Model.Payments.Any())
            {
                <div class="card border border-dashed rounded-3 bg-light py-4 px-3 text-center shadow-sm">
                    <div class="d-flex flex-column align-items-center gap-1.5">
                        <i class="bi bi-info-circle text-secondary opacity-75 fs-4"></i>
                        <span class="text-secondary small fw-medium">No payment transactions recorded for this invoice.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card border shadow-sm overflow-hidden rounded-3 mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary border-bottom fw-semibold small" style="letter-spacing: 0.3px;">
                                <tr>
                                    <th class="ps-3 py-2.5">Payment ID</th>
                                    <th class="py-2.5 text-end">Amount</th>
                                    <th class="py-2.5">Transaction Date</th>
                                    <th class="py-2.5">Method</th>
                                    <th class="pe-3 py-2.5">Reference String</th>
                                </tr>
                            </thead>

                            <tbody class="border-top-0 small">
                                @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace text-secondary">#@payment.PaymentId</td>
                                        <td class="text-end font-monospace fw-bold text-navy">
                                            @payment.Amount.ToString("0.000") <span class="fs-8 text-muted fw-normal">BHD</span>
                                        </td>
                                        <td class="text-secondary fw-medium">
                                            <i class="bi bi-clock text-muted small me-1"></i> @payment.PaymentDate.ToString("dd MMM yyyy HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border rounded px-2 py-1 font-monospace">
                                                @(payment.Method?.Name ?? "N/A")
                                            </span>
                                        </td>
                                        <td class="pe-3 font-monospace text-truncate text-muted" style="max-width: 150px;" title="@payment.TransactionReference">
                                            @(payment.TransactionReference ?? "N/A")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="row g-3 pt-3 border-top mt-4">
                <div class="col-md-3 order-md-3">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Edit"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-warning text-dark w-100 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5">
                        <i class="bi bi-pencil-fill"></i> Edit parameters
                    </a>
                </div>

                <div class="col-6 col-md-3 order-md-2">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Delete"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-outline-danger w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm"
                       onclick="return confirm('Are you sure you want to completely remove this invoice record?');">
                        <i class="bi bi-trash3"></i> Delete Record
                    </a>
                </div>

                <div class="col-6 col-md-3 order-md-1">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm">
                        <i class="bi bi-arrow-left"></i> Back to Ledger
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>