@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container mt-5" style="max-width: 850px;">
    <div class="card shadow-sm border-0 overflow-hidden rounded-3 mb-5">
       
        <div class="py-3 px-4 d-flex align-items-center justify-content-between text-white" style="background-color: #0d346d !important;">
            <h5 class="mb-0 fw-bold d-flex align-items-center gap-2" style="color: inherit;">
                <i class="bi bi-receipt"></i> Invoice Information
            </h5>
            <span class="badge bg-white text-dark font-monospace fw-bold px-2.5 py-1.5 border-0 shadow-sm" style="font-size: 0.85rem;">
                #@Model.InvoiceNumber
            </span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
         
            <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
                <div class="row g-4">
                    <div class="col-sm-6 border-bottom pb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Invoice Number</small>
                        <span class="fw-bold text-dark fs-6 font-monospace">@Model.InvoiceNumber</span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Lease Reference</small>
                        <span class="badge bg-light text-secondary border px-2 py-1 fw-semibold mt-0.5">
                            <i class="bi bi-file-earmark-text text-muted me-1"></i> Lease #@Model.LeaseId
                        </span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Tenant Name</small>
                        <span class="fw-bold text-dark fs-6">
                            @(Model.Lease?.Tenant != null
                                ? Model.Lease.Tenant.FirstName + " " + Model.Lease.Tenant.LastName
                                : "N/A")
                        </span>
                    </div>

                    <div class="col-sm-6 border-bottom pb-3">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Invoice Status</small>
                        <div class="mt-1">
                            @if (Model.Status?.Name == "Paid")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1.5">
                                    <span class="p-1 bg-success rounded-circle d-inline-block"></span> Paid
                                </span>
                            }
                            else if (Model.Status?.Name == "Overdue")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1.5">
                                    <span class="p-1 bg-danger rounded-circle d-inline-block"></span> Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1 rounded fw-bold d-inline-flex align-items-center gap-1.5">
                                    <span class="p-1 bg-warning rounded-circle d-inline-block"></span> @(Model.Status?.Name ?? "Pending")
                                </span>
                            }
                        </div>
                    </div>

                    <div class="col-sm-6 border-bottom border-sm-bottom-0 pb-3 pb-sm-0">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Property Allocation</small>
                        <span class="fw-bold text-dark d-block">@(Model.Lease?.Unit?.Property?.Name ?? "N/A")</span>
                        <small class="text-muted small fw-medium">Unit @(Model.Lease?.Unit?.UnitNumber ?? "N/A")</small>
                    </div>

                    <div class="col-sm-6 text-sm-end align-self-center">
                        <small class="text-muted d-block text-uppercase fw-semibold font-monospace mb-1" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Grand Amount</small>
                        <span class="font-monospace fw-bold text-dark fs-3 d-block" style="color: #0d346d !important;">
                            @Model.Amount.ToString("0.000") <span class="fs-6 text-muted fw-normal">BHD</span>
                        </span>
                    </div>
                </div>

              
                <div class="row g-3 mt-3 pt-3 border-top bg-light-subtle mx-n4 px-4 rounded-bottom">
                    <div class="col-6">
                        <small class="text-muted d-block small mb-1"><i class="bi bi-calendar-check me-1"></i> Issued Date</small>
                        <span class="text-secondary fw-semibold small font-monospace">@Model.IssuedDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted d-block small mb-1"><i class="bi bi-calendar-x me-1"></i> Due Date</small>
                        <span class="text-dark fw-bold small font-monospace">@Model.DueDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>
            </div>

          
            <h6 class="fw-bold mb-3 mt-4 d-flex align-items-center gap-2 text-dark text-uppercase font-monospace tracking-wider" style="font-size: 0.8rem; color: #0d346d !important;">
                <i class="bi bi-credit-card-2-back-fill opacity-75"></i> Payment Transactions History
            </h6>

            @if (!Model.Payments.Any())
            {
                <div class="card border border-dashed rounded-3 bg-white py-4 px-3 text-center shadow-sm">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <i class="bi bi-info-circle text-muted opacity-50 fs-4"></i>
                        <span class="text-secondary small fw-medium">No payment transactions recorded for this invoice.</span>
                    </div>
                </div>
            }
            else
            {
                <div class="card border border-light-subtle shadow-sm overflow-hidden rounded-3 mb-4 bg-white">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="bg-light text-secondary border-bottom fw-bold text-uppercase font-monospace" style="font-size: 0.72rem; letter-spacing: 0.3px;">
                                <tr>
                                    <th class="ps-3 py-3">Payment ID</th>
                                    <th class="py-3 text-end">Amount</th>
                                    <th class="py-3 ps-4">Transaction Date</th>
                                    <th class="py-3">Method</th>
                                    <th class="pe-3 py-3">Reference String</th>
                                </tr>
                            </thead>

                            <tbody class="border-top-0 text-secondary">
                                @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                {
                                    <tr>
                                        <td class="ps-3 font-monospace fw-medium text-dark">#@payment.PaymentId</td>
                                        <td class="text-end font-monospace fw-bold" style="color: #0d346d;">
                                            @payment.Amount.ToString("0.000") <span class="text-muted fw-normal" style="font-size: 0.7rem;">BHD</span>
                                        </td>
                                        <td class="text-secondary fw-medium font-monospace ps-4">
                                            <i class="bi bi-clock text-muted small me-1"></i> @payment.PaymentDate.ToString("dd MMM yyyy HH:mm")
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border rounded px-2 py-1 font-monospace fw-semibold">
                                                @(payment.Method?.Name ?? "N/A")
                                            </span>
                                        </td>
                                        <td class="pe-3 font-monospace text-truncate text-muted" style="max-width: 150px;" title="@payment.TransactionReference">
                                            @(payment.TransactionReference ?? "N/A")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

          
            <div class="row g-3 pt-3 border-top mt-4 align-items-center">
                <div class="col-6 col-md-3 order-md-1">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm btn-sm py-2">
                        <i class="bi bi-arrow-left"></i> Back to Ledger
                    </a>
                </div>

                <div class="col-6 col-md-3 order-md-2">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Delete"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-outline-danger w-100 fw-semibold d-inline-flex align-items-center justify-content-center gap-1.5 shadow-sm btn-sm py-2"
                       onclick="return confirm('Are you sure you want to completely remove this invoice record?');">
                        <i class="bi bi-trash3"></i> Delete Record
                    </a>
                </div>

                <div class="col-md-3 ms-md-auto order-md-3">
                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Edit"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-warning text-dark w-100 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center gap-1.5 btn-sm py-2">
                        <i class="bi bi-pencil-fill"></i> Edit Parameters
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>