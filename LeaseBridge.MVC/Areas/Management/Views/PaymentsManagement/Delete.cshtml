@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container mt-4" style="max-width: 750px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Invoice</h4>
        </div>

        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="alert alert-warning">
                <strong>Warning:</strong> Are you sure you want to delete this invoice?
                Invoices with payment transactions cannot be deleted.
            </div>

            <dl class="row">
                <dt class="col-sm-4">Invoice Number</dt>
                <dd class="col-sm-8">@Model.InvoiceNumber</dd>

                <dt class="col-sm-4">Lease ID</dt>
                <dd class="col-sm-8">@Model.LeaseId</dd>

                <dt class="col-sm-4">Tenant</dt>
                <dd class="col-sm-8">
                    @(Model.Lease?.Tenant != null
                                        ? Model.Lease.Tenant.FirstName + " " + Model.Lease.Tenant.LastName
                                        : "N/A")
                </dd>

                <dt class="col-sm-4">Amount</dt>
                <dd class="col-sm-8">@Model.Amount.ToString("0.000") BHD</dd>

                <dt class="col-sm-4">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@(Model.Status?.Name ?? "N/A")</dd>

                <dt class="col-sm-4">Payment Count</dt>
                <dd class="col-sm-8">@Model.Payments.Count</dd>
            </dl>

            <form asp-area="Management"
                  asp-controller="PaymentsManagement"
                  asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Delete Invoice
                    </button>

                    <a asp-area="Management"
                       asp-controller="PaymentsManagement"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>