@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="page-container d-flex justify-content-center align-items-center">
    <div class="card card-custom" style="width: 100%; max-width: 650px;">
        <div class="card-header" style="background-color: #dc3545; color: white; padding: 1.5rem;">
            <h4 class="mb-0 fw-bold">Confirm Deletion</h4>
        </div>

        <div class="card-body">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3 mb-4">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="alert alert-warning rounded-3 mb-4 border-0" style="background-color: #fff3cd; color: #856404;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Warning:</strong> Are you sure you want to delete this invoice?
                Invoices with payment transactions cannot be deleted.
            </div>

            <div class="bg-light p-4 rounded-4 mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-navy">Invoice Number</dt>
                    <dd class="col-sm-7 fw-bold">@Model.InvoiceNumber</dd>

                    <dt class="col-sm-5 text-navy">Tenant</dt>
                    <dd class="col-sm-7">@(Model.Lease?.Tenant != null ? $"{Model.Lease.Tenant.FirstName} {Model.Lease.Tenant.LastName}" : "N/A")</dd>

                    <dt class="col-sm-5 text-navy">Amount</dt>
                    <dd class="col-sm-7 fw-bold text-danger">@Model.Amount.ToString("0.000") BHD</dd>

                    <dt class="col-sm-5 text-navy">Due Date</dt>
                    <dd class="col-sm-7">@Model.DueDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-5 text-navy">Status</dt>
                    <dd class="col-sm-7"><span class="badge bg-secondary">@(Model.Status?.Name ?? "N/A")</span></dd>

                    <dt class="col-sm-5 text-navy">Payment Count</dt>
                    <dd class="col-sm-7">@Model.Payments.Count</dd>
                </dl>
            </div>

            <form asp-area="Management" asp-controller="PaymentsManagement" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-danger px-4 rounded-pill flex-grow-1">
                        Delete Invoice
                    </button>
                    <a asp-area="Management" asp-controller="PaymentsManagement" asp-action="Index"
                       class="btn btn-outline-secondary px-4 rounded-pill">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>