@model IEnumerable<LeaseBridge.API.Models.Notification>

@{
    ViewData["Title"] = "Management Notifications";
}

<div class="container mt-4 mb-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                System updates regarding applications, maintenance, and payments.
            </p>
        </div>

        <a asp-area="Management"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-pill px-4">
            Back to Dashboard
        </a>
    </div>

    <!-- Success Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Card -->
    <div class="card card-custom shadow-sm border-0 overflow-hidden">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <!-- HEADER (your navy system) -->
                <thead class="table-header-custom text-white">
                    <tr>
                        <th class="p-3">Message</th>
                        <th class="p-3">Type</th>
                        <th class="p-3">Status</th>
                        <th class="p-3">Date Received</th>
                        <th class="p-3 text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center p-5 text-muted">
                                No notifications to display.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Message -->
                                <td class="p-3">
                                    <span class="@(item.IsRead ? "text-secondary" : "fw-bold text-dark")">
                                        @item.Message
                                    </span>
                                </td>

                                <!-- Type -->
                                <td class="p-3">
                                    <span class="badge bg-light text-navy border">
                                        @(item.NotificationType ?? "General")
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="p-3">
                                    @if (item.IsRead)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                            Read
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                            Unread
                                        </span>
                                    }
                                </td>

                                <!-- Date -->
                                <td class="p-3 text-muted small">
                                    @item.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <!-- Actions -->
                                <td class="p-3 text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="Details"
                                           asp-route-id="@item.NotificationId"
                                           class="btn btn-sm btn-light border rounded-pill px-3 shadow-sm">
                                            Details
                                        </a>

                                        @if (!item.IsRead)
                                        {
                                            <form asp-action="MarkAsRead"
                                                  asp-route-id="@item.NotificationId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-navy rounded-pill px-3 shadow-sm">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Delete"
                                              asp-route-id="@item.NotificationId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="return confirm('Delete this notification?');">
                                                Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>
    </div>
</div>