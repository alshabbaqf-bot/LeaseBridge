@model IEnumerable<LeaseBridge.API.Models.Notification>

@{
    ViewData["Title"] = "Management Notifications";
}

<div class="container page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-navy fw-bold mb-1">Management Notifications</h2>
            <p class="text-muted small mb-0">
                View system notifications related to applications, maintenance, and payments.
            </p>
        </div>

        <a asp-area="Management"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary shadow-sm">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card-custom">
        <div class="table-responsive table-min-width">
            <table class="table align-middle mb-0">
                <thead class="table-header-custom table-header-uppercase">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Message</th>
                        <th>Type</th>
                        <th>Read</th>
                        <th>Created</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                No notifications found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-secondary small ps-4">@item.NotificationId</td>

                                <td>
                                    @if (!item.IsRead)
                                    {
                                        <strong class="text-navy">@item.Message</strong>
                                    }
                                    else
                                    {
                                        <span class="text-dark">@item.Message</span>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis px-2.5 py-1.5 rounded">
                                        @(item.NotificationType ?? "General")
                                    </span>
                                </td>

                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge bg-success-subtle text-success-emphasis px-2.5 py-1.5 rounded">Read</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis px-2.5 py-1.5 rounded">Unread</span>
                                    }
                                </td>

                                <td class="text-secondary small">@item.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>

                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-area="Management"
                                           asp-controller="Notifications"
                                           asp-action="Details"
                                           asp-route-id="@item.NotificationId"
                                           class="btn btn-info-subtle text-info-emphasis btn-sm">
                                            Details
                                        </a>

                                        @if (!item.IsRead)
                                        {
                                            <form asp-area="Management"
                                                  asp-controller="Notifications"
                                                  asp-action="MarkAsRead"
                                                  asp-route-id="@item.NotificationId"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn bg-success-subtle text-success-emphasis btn-sm rounded-0">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }

                                        <form asp-area="Management"
                                              asp-controller="Notifications"
                                              asp-action="Delete"
                                              asp-route-id="@item.NotificationId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-danger-subtle text-danger btn-sm"
                                                    onclick="return confirm('Delete this notification?');">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>