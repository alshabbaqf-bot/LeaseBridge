@model LeaseBridge.MVC.Areas.Management.Controllers.ManageStaffSkillsViewModel

@{
    ViewData["Title"] = "Manage Staff Skills";
}

<div class="container mt-5">
    <div class="card shadow border-0 overflow-hidden rounded-3">

        <div class="card-header bg-dark py-3 px-4 d-flex align-items-center justify-content-between">
            <div>
                <h5 class="mb-0 fw-bold text-white d-flex align-items-center gap-2">
                    <i class="bi bi-sliders text-primary"></i> Manage Staff Skills
                </h5>
                <small class="text-white-50 opacity-75 d-block mt-0.5">Configure operational capabilities and assignments</small>
            </div>
            <span class="badge bg-primary text-white fw-bold px-2.5 py-1.5 rounded">ROLES</span>
        </div>

        <div class="card-body p-4 bg-light-subtle">
            <div class="alert alert-info border-0 bg-white shadow-sm rounded-3 p-3 mb-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm p-3">
                        @(string.IsNullOrEmpty(Model.StaffName) ? "S" : Model.StaffName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <span class="text-muted small text-uppercase tracking-wider d-block font-monospace mb-0.5">Staff Member</span>
                        <h5 class="fw-bold text-dark mb-1">@Model.StaffName</h5>
                        <p class="text-secondary small mb-0">Select the functional skills and task types this staff member is assigned to manage.</p>
                    </div>
                </div>
            </div>

            <form asp-area="Management"
                  asp-controller="StaffManagement"
                  asp-action="ManageSkills"
                  asp-route-id="@Model.StaffId"
                  method="post">

                @Html.AntiForgeryToken()

                @if (!Model.Skills.Any())
                {
                    <div class="alert alert-warning border-0 shadow-sm p-3 mb-4 d-flex align-items-center gap-2 rounded-3">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <span class="fw-medium">No skills found in the system registry.</span>
                    </div>
                }
                else
                {
                    <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-sm mb-4">
                        <div class="list-group list-group-flush">
                            @foreach (var skill in Model.Skills)
                            {
                                <label class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-bottom">
                                    <div class="d-flex align-items-center gap-3">
                                        <input class="form-check-input mt-0"
                                               type="checkbox"
                                               name="selectedSkillIds"
                                               value="@skill.SkillId"
                                               id="skill_@skill.SkillId"
                                               @(skill.IsSelected ? "checked" : "") />

                                        <span class="fw-semibold text-dark">@skill.SkillName</span>
                                    </div>

                                    @if (skill.IsSelected)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill font-monospace fw-bold px-2 py-1 small">
                                            Active
                                        </span>
                                    }
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="row g-3 pt-3 border-top mt-2">
                    <div class="col-sm-6 order-sm-2">
                        <button type="submit" class="btn btn-success w-100 fw-bold shadow-sm py-2 d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-check-circle-fill"></i> Save Skills
                        </button>
                    </div>

                    <div class="col-sm-6 order-sm-1">
                        <a asp-area="Management"
                           asp-controller="StaffManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 fw-semibold py-2 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="bi bi-arrow-left"></i> Back to Staff
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>