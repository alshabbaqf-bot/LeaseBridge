@model LeaseBridge.MVC.Areas.Management.Controllers.ManageStaffSkillsViewModel

@{
    ViewData["Title"] = "Manage Staff Skills";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Manage Staff Skills</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-info">
                <strong>Staff:</strong> @Model.StaffName
                <br />
                Select the skills this staff member can handle.
            </div>

            <form asp-area="Management"
                  asp-controller="StaffManagement"
                  asp-action="ManageSkills"
                  asp-route-id="@Model.StaffId"
                  method="post">

                @Html.AntiForgeryToken()

                @if (!Model.Skills.Any())
                {
                    <div class="alert alert-warning">
                        No skills found.
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        @foreach (var skill in Model.Skills)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="selectedSkillIds"
                                       value="@skill.SkillId"
                                       id="skill_@skill.SkillId"
                                       @(skill.IsSelected ? "checked" : "") />

                                <label class="form-check-label" for="skill_@skill.SkillId">
                                    @skill.SkillName
                                </label>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Save Skills
                    </button>

                    <a asp-area="Management"
                       asp-controller="StaffManagement"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>