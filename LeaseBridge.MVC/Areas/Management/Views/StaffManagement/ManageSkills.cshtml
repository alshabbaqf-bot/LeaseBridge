@model LeaseBridge.MVC.Areas.Management.Controllers.ManageStaffSkillsViewModel

@{
    ViewData["Title"] = "Manage Staff Skills";
}

<div class="container my-5" style="max-width: 800px;">
    <div class="mb-4">
        <a asp-area="Management"
           asp-controller="StaffManagement"
           asp-action="Index"
           class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Staff Directory
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header border-0 bg-white pt-4 px-4 pb-2">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="mb-1 fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-sliders text-primary"></i> Manage Staff Skills
                    </h4>
                    <p class="text-muted small mb-0">Configure operational capabilities and assignments</p>
                </div>
                <span class="badge bg-light text-secondary border border-light-subtle fw-semibold px-3 py-2 rounded-pill small">System Registry</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="card border border-light-subtle rounded-3 bg-light-subtle p-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center fw-bold fs-5 shadow-sm p-3" style="width: 52px; height: 52px; min-width: 52px;">
                        @(string.IsNullOrEmpty(Model.StaffName) ? "S" : Model.StaffName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <span class="text-uppercase tracking-wider d-block fw-bold text-muted" style="font-size: 0.7rem; letter-spacing: 0.05rem;">Staff Member</span>
                        <h5 class="fw-bold text-dark mb-0">@Model.StaffName</h5>
                        <small class="text-secondary d-block mt-0.5">Select the functional skills and task types this staff member is assigned to manage.</small>
                    </div>
                </div>
            </div>

            <form asp-area="Management"
                  asp-controller="StaffManagement"
                  asp-action="ManageSkills"
                  asp-route-id="@Model.StaffId"
                  method="post">

                @Html.AntiForgeryToken()

                @if (!Model.Skills.Any())
                {
                    <div class="alert alert-warning border-0 shadow-sm p-4 text-center my-4 rounded-3">
                        <i class="bi bi-exclamation-triangle text-warning fs-1 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark mb-1">No Skills Registered</h6>
                        <span class="text-muted small">No available skills were discovered inside the system registry.</span>
                    </div>
                }
                else
                {
                    <p class="text-dark fw-bold small mb-2 text-uppercase tracking-wide px-1" style="font-size: 0.75rem;">Functional Skill Matrix</p>

                    <div class="card border border-light-subtle rounded-3 overflow-hidden shadow-sm mb-4">
                        <div class="list-group list-group-flush">
                            @foreach (var skill in Model.Skills)
                            {
                                <label class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-bottom" style="cursor: pointer;">
                                    <div class="d-flex align-items-center gap-3 w-100 me-2">
                                        <div class="form-check mb-0 fs-5 d-flex align-items-center">
                                            <input class="form-check-input mt-0 border-secondary-subtle"
                                                   style="cursor: pointer;"
                                                   type="checkbox"
                                                   name="selectedSkillIds"
                                                   value="@skill.SkillId"
                                                   id="skill_@skill.SkillId"
                                                   @(skill.IsSelected ? "checked" : "") />
                                        </div>
                                        <div class="d-flex flex-column">
                                            <span class="fw-semibold text-dark">@skill.SkillName</span>
                                        </div>
                                    </div>

                                    @if (skill.IsSelected)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill fw-medium px-2.5 py-1 small shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active
                                        </span>
                                    }
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="row g-3 pt-3 border-top mt-2">
                    <div class="col-sm-6 order-sm-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm py-2.5 d-inline-flex align-items-center justify-content-center gap-2 rounded-3">
                            <i class="bi bi-check-circle-fill"></i> Save Skills Configuration
                        </button>
                    </div>

                    <div class="col-sm-6 order-sm-1">
                        <a asp-area="Management"
                           asp-controller="StaffManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100 fw-semibold py-2.5 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm rounded-3">
                            Cancel Changes
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>