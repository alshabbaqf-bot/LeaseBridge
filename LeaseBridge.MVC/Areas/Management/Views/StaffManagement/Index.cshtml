@model IEnumerable<LeaseBridge.MVC.Areas.Management.Controllers.StaffProfileViewModel>

@{
    ViewData["Title"] = "Staff Management";
}

<div class="container mt-5">
   
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 border-bottom gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2" style="color: #0d346d !important;">
                <i class="bi bi-people-fill"></i> Staff Management
            </h2>
            <p class="text-muted mb-0">
                Manage internal team operational availability statuses, professional skill sets, and category profiles.
            </p>
        </div>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm p-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span class="fw-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    @if (!Model.Any())
    {
        <div class="card border border-dashed rounded-3 bg-white py-5 px-4 text-center shadow-sm">
            <div class="d-flex flex-column align-items-center gap-2 max-width-md mx-auto">
                <i class="bi bi-person-x text-muted opacity-50 display-5"></i>
                <h5 class="fw-bold text-dark mt-2 mb-1">No Active Staff Records</h5>
                <p class="text-secondary small mb-0">There are currently no staff user registration profiles mapped onto this administrative management segment.</p>
            </div>
        </div>
    }
    else
    {
      
        <div class="card shadow-sm border-0 overflow-hidden rounded-3 mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-white border-0 fw-semibold small" style="background-color: #0d346d !important; letter-spacing: 0.3px;">
                        <tr>
                            <th class="ps-4 py-3" style="background-color: transparent; color: inherit;">Staff Member</th>
                            <th class="py-3" style="background-color: transparent; color: inherit;">Email Address</th>
                            <th class="py-3" style="background-color: transparent; color: inherit;">Phone Line</th>
                            <th class="py-3" style="width: 25%; background-color: transparent; color: inherit;">Skill Categories</th>
                            <th class="py-3" style="background-color: transparent; color: inherit;">Status</th>
                            <th class="pe-4 py-3 text-end" style="width: 220px; background-color: transparent; color: inherit;">Operational Actions</th>
                        </tr>
                    </thead>

                    <tbody class="border-top-0 small text-secondary">
                        @foreach (var staff in Model)
                        {
                            <tr>
                              
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="avatar-placeholder rounded-circle d-flex align-items-center justify-content-center fw-bold font-monospace"
                                             style="width: 36px; height: 36px; min-width: 36px; background-color: rgba(13, 52, 109, 0.1); color: #0d346d;">
                                            @(string.IsNullOrEmpty(staff.FullName) ? "U" : staff.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block fs-6 lh-sm">@staff.FullName</span>
                                            <small class="text-muted font-monospace" style="font-size: 0.75rem;">ID: @staff.UserId</small>
                                        </div>
                                    </div>
                                </td>

                               
                                <td class="py-3">
                                    <a href="mailto:@staff.Email" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1.5">
                                        <i class="bi bi-envelope text-muted"></i> @staff.Email
                                    </a>
                                </td>

                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(staff.PhoneNumber))
                                    {
                                        <span class="text-dark font-monospace fw-medium">
                                            <i class="bi bi-telephone text-muted me-1"></i> @staff.PhoneNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-50 fst-italic">N/A</span>
                                    }
                                </td>

                               
                                <td class="py-3">
                                    @if (staff.SkillNames != null && staff.SkillNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var skill in staff.SkillNames)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-1 px-2 py-1 font-monospace fw-semibold" style="font-size: 0.75rem;">
                                                    @skill
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-75 small fst-italic d-flex align-items-center gap-1">
                                            <i class="bi bi-patch-question small text-secondary"></i> Unassigned
                                        </span>
                                    }
                                </td>

                                <td class="py-3">
                                    @if (staff.IsAvailable)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-bold d-inline-flex align-items-center gap-1.5">
                                            <span class="p-1 bg-success rounded-circle d-inline-block"></span> Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill fw-bold d-inline-flex align-items-center gap-1.5">
                                            <span class="p-1 bg-secondary rounded-circle d-inline-block"></span> Unavailable
                                        </span>
                                    }
                                </td>

                               
                                <td class="pe-4 py-3 text-end">
                                    <div class="d-inline-flex gap-2 justify-content-end align-items-center w-100">
                                        <a asp-area="Management"
                                           asp-controller="StaffManagement"
                                           asp-action="ManageSkills"
                                           asp-route-id="@staff.UserId"
                                           class="btn btn-sm btn-link text-decoration-none fw-semibold p-0"
                                           style="color: #0d346d; font-size: 0.85rem;">
                                            Manage Skills
                                        </a>

                                        <span class="text-muted opacity-40">|</span>

                                        <form asp-area="Management"
                                              asp-controller="StaffManagement"
                                              asp-action="ToggleAvailability"
                                              asp-route-id="@staff.UserId"
                                              method="post"
                                              class="d-inline m-0">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-link text-warning text-dark text-decoration-none fw-semibold p-0"
                                                    style="font-size: 0.85rem;">
                                                Toggle State
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>