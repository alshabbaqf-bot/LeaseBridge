@model IEnumerable<LeaseBridge.MVC.Areas.Management.Controllers.StaffProfileViewModel>

@{
    ViewData["Title"] = "Staff Management";
}

<div class="container mt-5">
    <!-- Clean Dashboard Header Block -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4 pb-3 border-bottom gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i> Staff Management
            </h2>
            <p class="text-muted mb-0">
                Manage internal team operational availability statuses, professional skill sets, and category profiles.
            </p>
        </div>
    </div>

    <!-- Alert Success Notification Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm p-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill fs-5"></i>
                <span class="fw-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Empty Database Records State Fallback Box -->
    @if (!Model.Any())
    {
        <div class="card border border-dashed rounded-3 bg-white py-5 px-4 text-center shadow-sm">
            <div class="d-flex flex-column align-items-center gap-2 max-width-md mx-auto">
                <i class="bi bi-person-x text-muted opacity-50 display-5"></i>
                <h5 class="fw-bold text-dark mt-2 mb-1">No Active Staff Records</h5>
                <p class="text-secondary small mb-0">There are currently no staff user registration profiles mapped onto this administrative management segment.</p>
            </div>
        </div>
    }
    else
    {
        <!-- Main Structured Data Panel Block -->
        <div class="card shadow-sm border-0 overflow-hidden rounded-3 mb-5">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark text-white border-0 fw-semibold small" style="letter-spacing: 0.3px;">
                        <tr>
                            <th class="ps-4 py-3">Staff Member</th>
                            <th class="py-3">Email Address</th>
                            <th class="py-3">Phone Line</th>
                            <th class="py-3" style="width: 30%;">Skill Categories</th>
                            <th class="py-3">Status</th>
                            <th class="pe-4 py-3 text-end">Operational Actions</th>
                        </tr>
                    </thead>

                    <tbody class="border-top-0 small text-secondary">
                        @foreach (var staff in Model)
                        {
                            <tr>
                                <!-- Primary Identification Column -->
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="avatar-placeholder bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold font-monospace" style="width: 36px; height: 36px; min-width: 36px;">
                                            @(string.IsNullOrEmpty(staff.FullName) ? "U" : staff.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block fs-6 lh-sm">@staff.FullName</span>
                                            <small class="text-muted font-monospace fs-8">ID: @staff.UserId</small>
                                        </div>
                                    </div>
                                </td>

                                <!-- Communication Channels Info Cells -->
                                <td class="py-3">
                                    <a href="mailto:@staff.Email" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1.5 hover-primary">
                                        <i class="bi bi-envelope text-muted"></i> @staff.Email
                                    </a>
                                </td>

                                <td class="py-3">
                                    @if (!string.IsNullOrEmpty(staff.PhoneNumber))
                                    {
                                        <span class="text-dark font-monospace fw-medium">
                                            <i class="bi bi-telephone text-muted me-1"></i> @staff.PhoneNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-50 italic">N/A</span>
                                    }
                                </td>

                                <!-- Tag Loops Block Container Area -->
                                <td class="py-3">
                                    @if (staff.SkillNames != null && staff.SkillNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var skill in staff.SkillNames)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-1 px-2 py-1 font-monospace fw-semibold fs-8">
                                                    @skill
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted opacity-75 small italic d-flex align-items-center gap-1">
                                            <i class="bi bi-patch-question small text-secondary"></i> No skills or categories assigned
                                        </span>
                                    }
                                </td>

                                <!-- Availability State Parameter Switches -->
                                <td class="py-3">
                                    @if (staff.IsAvailable)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-bold d-inline-flex align-items-center gap-1">
                                            <span class="p-0.5 bg-success rounded-circle"></span> Available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1 rounded-pill fw-bold d-inline-flex align-items-center gap-1">
                                            <span class="p-0.5 bg-secondary rounded-circle"></span> Unavailable
                                        </span>
                                    }
                                </td>

                                <!-- Interactive Operational Command Actions -->
                                <td class="pe-4 py-3 text-end">
                                    <div class="d-inline-flex gap-1.5 align-items-center">
                                        <a asp-area="Management"
                                           asp-controller="StaffManagement"
                                           asp-action="ManageSkills"
                                           asp-route-id="@staff.UserId"
                                           class="btn btn-outline-primary btn-sm fw-semibold px-2.5 d-inline-flex align-items-center gap-1 shadow-sm">
                                            <i class="bi bi-sliders"></i> Manage Skills
                                        </a>

                                        <form asp-area="Management"
                                              asp-controller="StaffManagement"
                                              asp-action="ToggleAvailability"
                                              asp-route-id="@staff.UserId"
                                              method="post"
                                              class="d-inline m-0">
                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-outline-warning text-dark btn-sm fw-semibold px-2.5 d-inline-flex align-items-center gap-1 shadow-sm">
                                                <i class="bi bi-arrow-left-right"></i> Toggle State
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>