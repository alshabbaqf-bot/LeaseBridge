@model IEnumerable<LeaseBridge.API.Models.Lease>

@{

    ViewData["Title"] = "Lease Management";

}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Lease Management</h2>
        <p class="text-muted">

            Manage active leases, renewals, and terminations.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)

    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

    }

    @if (TempData["ErrorMessage"] != null)

    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

    }

    @if (!Model.Any())

    {
        <div class="alert alert-info">

            No leases found.
        </div>

    }

    else

    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lease</th>
                            <th>Tenant</th>
                            <th>Property / Unit</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var lease in Model)

                        {
                            <tr>
                                <td>Lease #@lease.LeaseId</td>

                                <td>

                                    @(lease.Tenant != null

                                                                ? lease.Tenant.FirstName + " " + lease.Tenant.LastName

                                                                : "N/A")
                        </td>

                                <td>
                                    <strong>@(lease.Unit?.Property?.Name ?? "N/A")</strong>
                                    <br />
                                    <small class="text-muted">

                                        Unit @(lease.Unit?.UnitNumber ?? "N/A")
                                    </small>
                                </td>

                                <td>@lease.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@lease.EndDate.ToString("dd MMM yyyy")</td>

                                <td>

                            @if (lease.IsActive)

                                    {
                                        <span class="badge bg-success">Active</span>

                                    }

                                    else

                                    {
                                        <span class="badge bg-secondary">Inactive</span>

                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-area="Management"
                                       asp-controller="LeaseManagement"
                                       asp-action="Details"
                                       asp-route-id="@lease.LeaseId"
                                       class="btn btn-info btn-sm">

                                        Details
                                    </a>

                                    @if (lease.IsActive)

                                    {
                                        <a asp-area="Management"
                                           asp-controller="LeaseManagement"
                                           asp-action="Renew"
                                           asp-route-id="@lease.LeaseId"
                                           class="btn btn-primary btn-sm">

                                            Renew
                                        </a>

                                        <a asp-area="Management"
                                           asp-controller="LeaseManagement"
                                           asp-action="Terminate"
                                           asp-route-id="@lease.LeaseId"
                                           class="btn btn-danger btn-sm">

                                            Terminate
                                        </a>

                                    }
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
</div>
