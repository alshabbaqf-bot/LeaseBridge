@model IEnumerable<LeaseBridge.API.Models.Lease>

@{
    ViewData["Title"] = "Lease Management";
}

<div class="container mt-4">
    <!-- Header Summary Block -->
    <div class="mb-4">
        <h2 class="text-navy fw-bold mb-1">Lease Management</h2>
        <p class="text-muted">
            Manage active leases, renewals, and terminations.
        </p>
    </div>

    <!-- Feedback Context Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Empty State Fallback -->
    @if (!Model.Any())
    {
        <div class="alert bg-info-subtle text-info-emphasis border-0 shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-info-circle-fill"></i> No leases found.
        </div>
    }
    else
    {
        <!-- Modernized Grid Panel -->
        <div class="card-custom shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-header-custom table-header-uppercase">
                        <tr>
                            <th class="ps-3">Lease</th>
                            <th>Tenant</th>
                            <th>Property / Unit</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var lease in Model)
                        {
                            <tr>
                                <!-- Highlighted Index Token -->
                                <td class="fw-bold text-navy ps-3">#@lease.LeaseId</td>

                                <td class="text-dark fw-semibold">
                                    @(lease.Tenant != null
                                                                ? lease.Tenant.FirstName + " " + lease.Tenant.LastName
                                                                : "N/A")
                        </td>

                                <!-- Nested Metadata Stack -->
                                <td>
                                    <span class="text-dark fw-medium d-block mb-0.5">@(lease.Unit?.Property?.Name ?? "N/A")</span>
                                    <span class="badge bg-light text-dark border px-2 py-0.5 fw-semibold fs-7">
                                        Unit @(lease.Unit?.UnitNumber ?? "N/A")
                                    </span>
                                </td>

                                <td class="text-secondary fw-medium">@lease.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="text-secondary fw-medium">@lease.EndDate.ToString("dd MMM yyyy")</td>

                                <!-- Conditional Capsule Badges -->
                                <td>
                            @if (lease.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-bold">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1.5 rounded-pill fw-bold">Inactive</span>
                                    }
                                </td>

                                <!-- Inline Command Stack -->
                                <td class="text-center pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-area="Management"
                                           asp-controller="LeaseManagement"
                                           asp-action="Details"
                                           asp-route-id="@lease.LeaseId"
                                           class="btn btn-navy btn-sm px-2.5 fw-semibold d-inline-flex align-items-center gap-1"
                                           title="View Lease Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (lease.IsActive)
                                        {
                                            <a asp-area="Management"
                                               asp-controller="LeaseManagement"
                                               asp-action="Renew"
                                               asp-route-id="@lease.LeaseId"
                                               class="btn btn-secondary btn-sm px-2.5 fw-semibold d-inline-flex align-items-center gap-1"
                                               title="Renew Contract">
                                                <i class="bi bi-arrow-repeat"></i> Renew
                                            </a>

                                            <a asp-area="Management"
                                               asp-controller="LeaseManagement"
                                               asp-action="Terminate"
                                               asp-route-id="@lease.LeaseId"
                                               class="btn btn-outline-danger btn-sm px-2.5 fw-semibold d-inline-flex align-items-center gap-1"
                                               title="Terminate Contract">
                                                <i class="bi bi-x-circle"></i> Terminate
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>