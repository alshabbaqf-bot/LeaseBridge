@model LeaseBridge.API.Models.Lease

@{
    ViewData["Title"] = "Terminate Lease";
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Terminate Lease</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-warning">
                Are you sure you want to terminate this lease?
                The unit will become available again.
            </div>

            <dl class="row">
                <dt class="col-sm-4">Lease</dt>
                <dd class="col-sm-8">#@Model.LeaseId</dd>

                <dt class="col-sm-4">Tenant</dt>
                <dd class="col-sm-8">
                    @(Model.Tenant != null
                                        ? Model.Tenant.FirstName + " " + Model.Tenant.LastName
                                        : "N/A")
                </dd>

                <dt class="col-sm-4">Unit</dt>
                <dd class="col-sm-8">@(Model.Unit?.UnitNumber ?? "N/A")</dd>

                <dt class="col-sm-4">Current End Date</dt>
                <dd class="col-sm-8">@Model.EndDate.ToString("dd MMM yyyy")</dd>
            </dl>

            <form asp-area="Management"
                  asp-controller="LeaseManagement"
                  asp-action="ConfirmTerminate"
                  asp-route-id="@Model.LeaseId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Confirm Termination
                    </button>

                    <a asp-area="Management"
                       asp-controller="LeaseManagement"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>