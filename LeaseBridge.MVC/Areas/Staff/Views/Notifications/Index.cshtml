@model IEnumerable<LeaseBridge.API.Models.Notification>

@{

    ViewData["Title"] = "Staff Notifications";

}

<div class="container mt-4">
    <div class="mb-4">
        <h2>Staff Notifications</h2>
        <p class="text-muted">

            View maintenance assignments and task updates sent to you.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)

    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

    }

    @if (TempData["ErrorMessage"] != null)

    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>

    }

    @if (!Model.Any())

    {
        <div class="alert alert-info">

            No notifications found.
        </div>

    }

    else

    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Message</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var notification in Model)

                        {
                            <tr>
                                <td>

                                    @if (!notification.IsRead)

                                    {
                                        <strong>@notification.Message</strong>

                                    }

                                    else

                                    {
                                        <span>@notification.Message</span>

                                    }
                                </td>

                                <td>@(notification.NotificationType ?? "General")</td>

                                <td>

                                    @if (notification.IsRead)

                                    {
                                        <span class="badge bg-success">Read</span>

                                    }

                                    else

                                    {
                                        <span class="badge bg-warning text-dark">Unread</span>

                                    }
                                </td>

                                <td>@notification.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>

                                <td class="text-center">
                                    <a asp-area="Staff"
                                       asp-controller="Notifications"
                                       asp-action="Details"
                                       asp-route-id="@notification.NotificationId"
                                       class="btn btn-sm btn-outline-primary">

                                        View
                                    </a>

                                    @if (!notification.IsRead)

                                    {
                                        <form asp-area="Staff"
                                              asp-controller="Notifications"
                                              asp-action="MarkAsRead"
                                              asp-route-id="@notification.NotificationId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit" class="btn btn-sm btn-success">

                                                Mark Read
                                            </button>
                                        </form>

                                    }
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>

    }
</div>

