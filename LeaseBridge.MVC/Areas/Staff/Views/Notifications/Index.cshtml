@model IEnumerable<LeaseBridge.API.Models.Notification>

@{
    ViewData["Title"] = "Staff Notifications";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="text-navy fw-bold mb-1">Staff Notifications</h2>
        <p class="text-muted">
            View maintenance assignments and task updates sent to you.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert bg-info-subtle text-info-emphasis border-0 shadow-sm">
            No notifications found.
        </div>
    }
    else
    {
        <div class="card-custom shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-header-custom table-header-uppercase">
                        <tr>
                            <th class="ps-3">Message</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var notification in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!notification.IsRead)
                                    {
                                        <strong class="text-dark">@notification.Message</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@notification.Message</span>
                                    }
                                </td>

                                <td>
                                    <span class="fw-semibold text-secondary">@(notification.NotificationType ?? "General")</span>
                                </td>

                                <td>
                                    @if (notification.IsRead)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-bold">Read</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-bold">Unread</span>
                                    }
                                </td>

                                <td class="text-muted text-nowrap">@notification.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>

                                <td class="text-center pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-area="Staff"
                                           asp-controller="Notifications"
                                           asp-action="Details"
                                           asp-route-id="@notification.NotificationId"
                                           class="btn btn-navy btn-sm px-3 fw-semibold shadow-sm">
                                            View
                                        </a>

                                        @if (!notification.IsRead)
                                        {
                                            <form asp-area="Staff"
                                                  asp-controller="Notifications"
                                                  asp-action="MarkAsRead"
                                                  asp-route-id="@notification.NotificationId"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit" class="btn btn-secondary btn-sm px-3 fw-semibold shadow-sm">
                                                    Mark Read
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>