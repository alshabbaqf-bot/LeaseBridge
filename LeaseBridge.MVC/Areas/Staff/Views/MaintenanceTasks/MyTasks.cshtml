@model IEnumerable<LeaseBridge.MVC.Areas.Staff.Controllers.StaffMaintenanceTaskViewModel>

@{
    ViewData["Title"] = "My Assigned Tasks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Assigned Maintenance Tasks</h2>
            <p class="text-muted mb-0">
                View maintenance requests assigned to you.
            </p>
        </div>

        <a asp-area="Staff"
           asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Staff Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No maintenance tasks are currently assigned to you.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Ticket</th>
                            <th>Title</th>
                            <th>Tenant</th>
                            <th>Unit</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@task.TicketNumber</td>

                                <td>
                                    <strong>@task.Title</strong>
                                    <br />
                                    <small class="text-muted">
                                        @(task.Description ?? "No description provided.")
                                    </small>
                                </td>

                                <td>@task.TenantName</td>

                                <td>@task.UnitNumber</td>

                                <td>@task.CategoryName</td>

                                <td>
                                    @if (task.PriorityName.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                                                task.PriorityName.Equals("Urgent", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">@task.PriorityName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@task.PriorityName</span>
                                    }
                                </td>

                                <td>
                                    @if (task.StatusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                                                                task.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">@task.StatusName</span>
                                    }
                                    else if (task.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">@task.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white">@task.StatusName</span>
                                    }
                                </td>

                                <td>@task.AssignedDate.ToString("dd MMM yyyy")</td>

                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-area="Staff"
                                           asp-controller="MaintenanceTasks"
                                           asp-action="Details"
                                           asp-route-id="@task.RequestId"
                                           class="btn btn-info btn-sm">

                                            Details
                                        </a>

                                        <a asp-area="Staff"
                                           asp-controller="MaintenanceTasks"
                                           asp-action="UpdateProgress"
                                           asp-route-id="@task.RequestId"
                                           class="btn btn-warning btn-sm">

                                            Update
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>