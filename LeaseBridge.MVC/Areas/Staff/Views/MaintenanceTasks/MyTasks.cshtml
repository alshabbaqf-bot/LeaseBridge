@model IEnumerable<LeaseBridge.MVC.Areas.Staff.Controllers.StaffMaintenanceTaskViewModel>

@{
    ViewData["Title"] = "My Assigned Tasks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-navy fw-bold mb-1">My Assigned Maintenance Tasks</h2>
            <p class="text-muted mb-0">
                View maintenance requests assigned to you.
            </p>
        </div>

        <a asp-area="Staff"
           asp-controller="Home"
           asp-action="Index"
           class="btn btn-navy px-4 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
            Staff Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert bg-info-subtle text-info-emphasis border-0 shadow-sm">
            No maintenance tasks are currently assigned to you.
        </div>
    }
    else
    {
        <div class="card-custom shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-header-custom table-header-uppercase">
                        <tr>
                            <th class="ps-3">Ticket</th>
                            <th>Title / Description</th>
                            <th>Tenant</th>
                            <th>Unit</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned Date</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="fw-bold text-navy ps-3">@task.TicketNumber</td>

                                <td>
                                    <span class="text-dark fw-semibold d-block mb-0.5">@task.Title</span>
                                    <small class="text-muted d-block line-clamp-2">
                                        @(task.Description ?? "No description provided.")
                                    </small>
                                </td>

                                <td class="text-dark fw-medium">@task.TenantName</td>

                                <td class="text-secondary fw-bold">@task.UnitNumber</td>

                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1 fw-semibold">@task.CategoryName</span>
                                </td>

                                <td>
                                    @if (task.PriorityName.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                                                task.PriorityName.Equals("Urgent", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill fw-bold">@task.PriorityName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill fw-semibold">@task.PriorityName</span>
                                    }
                                </td>

                                <td>
                                    @if (task.StatusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                                                                task.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill fw-bold">@task.StatusName</span>
                                    }
                                    else if (task.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1.5 rounded-pill fw-bold">@task.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 rounded-pill fw-bold">@task.StatusName</span>
                                    }
                                </td>

                                <td class="text-muted text-nowrap">@task.AssignedDate.ToString("dd MMM yyyy")</td>

                                <td class="text-center pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-area="Staff"
                                           asp-controller="MaintenanceTasks"
                                           asp-action="Details"
                                           asp-route-id="@task.RequestId"
                                           class="btn btn-navy btn-sm px-2.5 fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                                           title="View Task Details">
                                           Details
                                        </a>

                                        <a asp-area="Staff"
                                           asp-controller="MaintenanceTasks"
                                           asp-action="UpdateProgress"
                                           asp-route-id="@task.RequestId"
                                           class="btn btn-secondary btn-sm px-2.5 fw-semibold shadow-sm d-inline-flex align-items-center gap-1"
                                           title="Update Progress">
                                            <i class="bi bi-pencil-square"></i> Update
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>