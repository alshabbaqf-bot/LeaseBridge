@{
    ViewData["Title"] = "Update Task Progress";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Update Task Progress</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-info">
                <strong>Ticket:</strong> @ViewBag.TicketNumber <br />
                <strong>Title:</strong> @ViewBag.Title
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-area="Staff"
                  asp-controller="MaintenanceTasks"
                  asp-action="UpdateProgress"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="requestId" value="@ViewBag.RequestId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">New Status</label>

                    <select name="statusId" class="form-select" required>
                        <option value="">-- Select Status --</option>

                        @foreach (var status in ViewBag.Statuses)
                        {
                            if (ViewBag.CurrentStatusId != null && status.StatusId == ViewBag.CurrentStatusId)
                            {
                                <option value="@status.StatusId" selected>@status.Name</option>
                            }
                            else
                            {
                                <option value="@status.StatusId">@status.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Progress Notes</label>

                    <textarea name="notes"
                              class="form-control"
                              rows="4"
                              placeholder="Example: Inspected the issue and ordered replacement parts."
                              required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Save Update
                    </button>

                    <a asp-area="Staff"
                       asp-controller="MaintenanceTasks"
                       asp-action="MyTasks"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>