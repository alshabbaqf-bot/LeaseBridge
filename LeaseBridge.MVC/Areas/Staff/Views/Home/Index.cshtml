@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="text-navy fw-bold">Staff Dashboard</h2>
        <p class="text-muted">
            View your assigned maintenance tasks, update progress, and check notifications.
        </p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card-custom shadow-sm h-100">
                <div class="card-body d-flex flex-column h-100">
                    <h5 class="card-title text-navy fw-bold">My Assigned Tasks</h5>
                    <p class="card-text text-muted mb-4">
                        View maintenance requests assigned to you.
                    </p>
                    <a asp-area="Staff"
                       asp-controller="MaintenanceTasks"
                       asp-action="MyTasks"
                       class="btn btn-navy w-100 mt-auto">
                        View Tasks
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-custom shadow-sm h-100">
                <div class="card-body d-flex flex-column h-100">
                    <h5 class="card-title text-navy fw-bold">Update Progress</h5>
                    <p class="card-text text-muted mb-4">
                        Add progress notes and update maintenance request status.
                    </p>
                    <a asp-area="Staff"
                       asp-controller="MaintenanceTasks"
                       asp-action="MyTasks"
                       class="btn btn-navy w-100 mt-auto">
                        Update Tasks
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-custom shadow-sm h-100">
                <div class="card-body d-flex flex-column h-100">
                    <h5 class="card-title text-navy fw-bold">My Notifications</h5>
                    <p class="card-text text-muted mb-4">
                        View assignment alerts and maintenance updates sent to you.
                    </p>
                    <a asp-area="Staff"
                       asp-controller="Notifications"
                       asp-action="Index"
                       class="btn btn-navy w-100 mt-auto">
                        View Notifications
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>