@model IEnumerable<LeaseBridge.API.Models.Unit>

@{
    ViewData["Title"] = "Available Rental Units";
}

<div class="container page-container">

    <!-- HEADER -->
    <div class="mb-4 text-center">
        <h2 class="fw-bold text-navy mb-1">Available Rental Units</h2>
        <p class="text-muted mb-0">
            Browse currently available units and submit a lease application.
        </p>
    </div>

    <!-- EMPTY STATE -->
    @if (!Model.Any())
    {
        <div class="card card-custom text-center p-5">
            <h5 class="text-muted mb-2">No Units Available</h5>
            <p class="text-muted mb-0">
                There are currently no rental units listed in the system.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var unit in Model)
            {
                <div class="col-md-4">
                    <div class="card card-custom hover-lift h-100 position-relative">

                        @{
                            string statusName = unit.Status?.Name ?? "Available";
                            string badgeClass = statusName == "Available" ? "bg-success" : "bg-secondary";
                        }
                        <div class="position-absolute top-0 end-0 p-3">
                            <span class="badge @badgeClass shadow-sm px-3 py-2">
                                @statusName
                            </span>
                        </div>

                        <div class="card-body">
                            <h5 class="fw-bold text-navy mb-1">Unit @unit.UnitNumber</h5>
                            <p class="text-muted small mb-3">@(unit.Property?.Name ?? "Property not specified")</p>

                            <div class="mb-3">
                                <span class="text-muted small">Size</span><br />
                                <span class="fw-semibold">@unit.Size sqft</span>
                            </div>

                            <hr />

                            <div class="mt-3">
                                <h4 class="fw-bold text-navy mb-0">@unit.RentAmount.ToString("0.000") BHD</h4>
                                <small class="text-muted">per month</small>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <a asp-area="Tenant" asp-controller="AvailableUnits" asp-action="Details" asp-route-id="@unit.UnitId"
                               class="btn btn-outline-secondary w-100 rounded-pill mb-2">View Details</a>

                            <a asp-area="Tenant" asp-controller="Application" asp-action="Apply" asp-route-unitId="@unit.UnitId"
                               class="btn btn-navy w-100 rounded-pill">Apply Now</a>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>