@model IEnumerable<LeaseBridge.API.Models.Unit>

@{
    ViewData["Title"] = "Available Rental Units";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h2>Available Rental Units</h2>
        <p class="text-muted">
            Browse currently available units and submit a lease application.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No available rental units are currently listed.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var unit in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title">Unit @unit.UnitNumber</h5>

                            <h6 class="card-subtitle mb-2 text-muted">
                                @(unit.Property?.Name ?? "Property not specified")
                            </h6>

                            <p class="card-text mb-1">
                                <strong>Size:</strong> @unit.Size sqft
                            </p>

                            <p class="card-text mb-1">
                                <strong>Status:</strong> @(unit.Status?.Name ?? "Available")
                            </p>

                            <hr />

                            <h4 class="text-primary">
                                @unit.RentAmount.ToString("0.000") BHD
                                <small class="text-muted">/ month</small>
                            </h4>
                        </div>

                        <div class="card-footer bg-white border-top-0">
                            <a asp-area="Tenant"
                               asp-controller="AvailableUnits"
                               asp-action="Details"
                               asp-route-id="@unit.UnitId"
                               class="btn btn-outline-secondary w-100 mb-2">
                                View Details
                            </a>

                            <a asp-area="Tenant"
                               asp-controller="Application"
                               asp-action="Apply"
                               asp-route-unitId="@unit.UnitId"
                               class="btn btn-primary w-100">
                                Apply Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>