@model LeaseBridge.API.Models.Unit

@{
    ViewData["Title"] = "Unit Details";
}

<div class="page-container container" style="max-width: 850px;">

    <div class="card card-custom shadow-lg">

        <div class="card-header-navy">
            <h4 class="mb-0 fw-bold">Unit @Model.UnitNumber Details</h4>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <span class="text-muted small">Property</span>
                        <div class="fw-bold text-navy">@(Model.Property?.Name ?? "N/A")</div>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small">Unit Number</span>
                        <div class="fw-semibold text-dark">@Model.UnitNumber</div>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small">Size</span>
                        <div class="fw-semibold text-dark">@Model.Size sqft</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <span class="text-muted small">Monthly Rent</span>
                        <div class="fw-bold text-navy fs-4">@Model.RentAmount.ToString("0.000") BHD</div>
                    </div>
                    <div class="mb-3">
                        <span class="text-muted small">Status</span><br />
                        @{
                            string statusName = Model.Status?.Name ?? "Available";
                            string badgeClass = statusName == "Available" ? "bg-success text-white" : "bg-light text-navy border";
                        }
                        <span class="badge @badgeClass px-3 py-2">@statusName</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4 pt-3 border-top">
                <a asp-area="Tenant" asp-controller="Application" asp-action="Apply"
                   asp-route-unitId="@Model.UnitId" class="btn btn-navy rounded-pill px-4">
                    Apply for this Unit
                </a>
                <a asp-area="Tenant" asp-controller="AvailableUnits" asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill px-4">
                    Back
                </a>
            </div>
        </div>
    </div>
</div>