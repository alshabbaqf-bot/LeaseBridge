@model LeaseBridge.API.Models.Unit

@{
    ViewData["Title"] = "Unit Details";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Unit @Model.UnitNumber Details</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Property</dt>
                <dd class="col-sm-8">@(Model.Property?.Name ?? "N/A")</dd>

                <dt class="col-sm-4">Unit Number</dt>
                <dd class="col-sm-8">@Model.UnitNumber</dd>

                <dt class="col-sm-4">Size</dt>
                <dd class="col-sm-8">@Model.Size sqft</dd>

                <dt class="col-sm-4">Monthly Rent</dt>
                <dd class="col-sm-8">@Model.RentAmount.ToString("0.000") BHD</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-success">
                        @(Model.Status?.Name ?? "Available")
                    </span>
                </dd>
            </dl>

            <div class="d-flex gap-2 mt-4">
                <a asp-area="Tenant"
                   asp-controller="Application"
                   asp-action="Apply"
                   asp-route-unitId="@Model.UnitId"
                   class="btn btn-primary">
                    Apply for this Unit
                </a>

                <a asp-area="Tenant"
                   asp-controller="AvailableUnits"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Available Units
                </a>
            </div>
        </div>
    </div>
</div>