@{
    ViewData["Title"] = "Tenant Dashboard";
}

<div class="container page-container">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold text-navy mb-1">Tenant Dashboard</h2>
        <p class="text-muted mb-0">
            Manage your lease applications, maintenance requests, and payments.
        </p>
    </div>

    <!-- GRID -->
    <div class="row g-4">

        <!-- Browse Units -->
        <div class="col-md-4">
            <div class="card card-custom">
                <div class="card-body">

                    <h5 class="fw-bold text-navy">Browse Units</h5>
                    <p class="text-muted small mb-3">
                        View available rental units and submit a lease application.
                    </p>

                    <a asp-area="Tenant"
                       asp-controller="AvailableUnits"
                       asp-action="Index"
                       class="btn btn-outline-primary rounded-pill px-4">
                        Browse Units
                    </a>

                </div>
            </div>
        </div>

        <!-- My Applications -->
        <div class="col-md-4">
            <div class="card card-custom">
                <div class="card-body">

                    <h5 class="fw-bold text-navy">My Applications</h5>
                    <p class="text-muted small mb-3">
                        Track your submitted lease applications and their status.
                    </p>

                    <a asp-area="Tenant"
                       asp-controller="Application"
                       asp-action="MyApplications"
                       class="btn btn-outline-primary rounded-pill px-4">
                        View Applications
                    </a>

                </div>
            </div>
        </div>

        <!-- Maintenance Requests -->
        <div class="col-md-4">
            <div class="card card-custom">
                <div class="card-body">

                    <h5 class="fw-bold text-navy">Maintenance Requests</h5>
                    <p class="text-muted small mb-3">
                        Submit and track maintenance requests.
                    </p>

                    <a asp-area="Tenant"
                       asp-controller="Maintenance"
                       asp-action="MyRequests"
                       class="btn btn-outline-primary rounded-pill px-4">
                        My Requests
                    </a>

                </div>
            </div>
        </div>

        <!-- Raise Ticket -->
        <div class="col-md-4">
            <div class="card card-custom">
                <div class="card-body">

                    <h5 class="fw-bold text-navy">Submit Maintenance</h5>
                    <p class="text-muted small mb-3">
                        Report an issue in your rented unit quickly.
                    </p>

                    <a asp-area="Tenant"
                       asp-controller="Maintenance"
                       asp-action="RaiseTicket"
                       class="btn btn-outline-primary rounded-pill px-4">
                        Raise Ticket
                    </a>

                </div>
            </div>
        </div>

        <!-- Payments -->
        <div class="col-md-4">
            <div class="card card-custom">
                <div class="card-body">

                    <h5 class="fw-bold text-navy">My Payments</h5>
                    <p class="text-muted small mb-3">
                        View rent payments, due dates, and status history.
                    </p>

                    <a asp-area="Tenant"
                       asp-controller="Payment"
                       asp-action="MyPayments"
                       class="btn btn-outline-primary rounded-pill px-4">
                        View Payments
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>