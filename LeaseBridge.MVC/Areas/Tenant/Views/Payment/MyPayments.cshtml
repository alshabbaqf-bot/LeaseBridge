@model IEnumerable<LeaseBridge.API.Models.Invoice>

@{
    ViewData["Title"] = "My Payments";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>My Payments</h2>
        <p class="text-muted">
            View your lease invoices, due dates, and payment statuses.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No invoice records found.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Invoice</th>
                            <th>Property / Unit</th>
                            <th>Amount</th>
                            <th>Issued Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Last Payment</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var invoice in Model)
                        {
                            var latestPayment = invoice.Payments
                            .OrderByDescending(p => p.PaymentDate)
                            .FirstOrDefault();

                            <tr>
                                <td>@invoice.InvoiceNumber</td>

                                <td>
                                    <strong>@(invoice.Lease?.Unit?.Property?.Name ?? "N/A")</strong>
                                    <br />
                                    <small class="text-muted">
                                        Unit @(invoice.Lease?.Unit?.UnitNumber ?? "N/A")
                                    </small>
                                </td>

                                <td>@invoice.Amount.ToString("0.000") BHD</td>
                                <td>@invoice.IssuedDate.ToString("dd MMM yyyy")</td>
                                <td>@invoice.DueDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (invoice.Status?.Name == "Paid")
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (invoice.Status?.Name == "Overdue")
                                    {
                                        <span class="badge bg-danger">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            @(invoice.Status?.Name ?? "Pending")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (latestPayment != null)
                                    {
                                        <span>@latestPayment.PaymentDate.ToString("dd MMM yyyy")</span>
                                        <br />
                                        <small class="text-muted">@latestPayment.Method?.Name</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Paid</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-area="Tenant"
                                       asp-controller="Payment"
                                       asp-action="Details"
                                       asp-route-id="@invoice.InvoiceId"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    @if (invoice.Status?.Name != "Paid")
                                    {
                                        <a asp-area="Tenant"
                                           asp-controller="Payment"
                                           asp-action="Pay"
                                           asp-route-id="@invoice.InvoiceId"
                                           class="btn btn-success btn-sm">
                                            Pay
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>