@model LeaseBridge.API.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container mt-4" style="max-width: 800px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Invoice Details</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Invoice Number</dt>
                <dd class="col-sm-8">@Model.InvoiceNumber</dd>

                <dt class="col-sm-4">Property</dt>
                <dd class="col-sm-8">@(Model.Lease?.Unit?.Property?.Name ?? "N/A")</dd>

                <dt class="col-sm-4">Unit</dt>
                <dd class="col-sm-8">@(Model.Lease?.Unit?.UnitNumber ?? "N/A")</dd>

                <dt class="col-sm-4">Amount</dt>
                <dd class="col-sm-8">@Model.Amount.ToString("0.000") BHD</dd>

                <dt class="col-sm-4">Issued Date</dt>
                <dd class="col-sm-8">@Model.IssuedDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Due Date</dt>
                <dd class="col-sm-8">@Model.DueDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @if (Model.Status?.Name == "Paid")
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else if (Model.Status?.Name == "Overdue")
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            @(Model.Status?.Name ?? "Pending")
                        </span>
                    }
                </dd>
            </dl>

            <h5 class="mt-4">Payment Transactions</h5>

            @if (!Model.Payments.Any())
            {
                <div class="alert alert-info">
                    No payment transactions recorded for this invoice.
                </div>
            }
            else
            {
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Payment ID</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Method</th>
                            <th>Reference</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                        {
                            <tr>
                                <td>@payment.PaymentId</td>
                                <td>@payment.Amount.ToString("0.000") BHD</td>
                                <td>@payment.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@(payment.Method?.Name ?? "N/A")</td>
                                <td>@(payment.TransactionReference ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="d-flex gap-2 mt-4">
                @if (Model.Status?.Name != "Paid")
                {
                    <a asp-area="Tenant"
                       asp-controller="Payment"
                       asp-action="Pay"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-success">
                        Pay Now
                    </a>
                }

                <a asp-area="Tenant"
                   asp-controller="Payment"
                   asp-action="MyPayments"
                   class="btn btn-secondary">
                    Back
                </a>
            </div>
        </div>
    </div>
</div>