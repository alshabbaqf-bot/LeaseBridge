@{

    ViewData["Title"] = "Submit Rental Application";

}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Submit Rental Application</h4>
        </div>

        <div class="card-body">

            @if (TempData["ErrorMessage"] != null)

            {
                <div class="alert alert-danger">

                    @TempData["ErrorMessage"]
                </div>

            }

            <div class="alert alert-info">
                <strong>Tenant:</strong> @ViewBag.TenantName <br />
                <strong>Unit:</strong> @ViewBag.UnitNumber <br />
                <strong>Property:</strong> @ViewBag.PropertyName <br />
                <strong>Monthly Rent:</strong> @Convert.ToDecimal(ViewBag.RentAmount).ToString("0.000") BHD
            </div>

            <form asp-area="Tenant"
                  asp-controller="Application"
                  asp-action="SubmitApplication"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="unitId" value="@ViewBag.UnitId" />

                <p class="text-muted">

                    By submitting this form, your application will be sent to the property manager for review.
                </p>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">

                        Submit Application
                    </button>

                    <a asp-area="Tenant"
                       asp-controller="AvailableUnits"
                       asp-action="Index"
                       class="btn btn-secondary">

                        Back to Units
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
