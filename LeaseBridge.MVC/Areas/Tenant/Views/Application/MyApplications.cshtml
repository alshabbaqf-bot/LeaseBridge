@model IEnumerable<LeaseBridge.API.Models.Application>

@{
    ViewData["Title"] = "My Applications";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-navy fw-bold mb-1">My Applications</h2>
            <p class="text-muted mb-0">
                View your submitted rental applications and their current status.
            </p>
        </div>

        <a asp-area="Tenant"
           asp-controller="AvailableUnits"
           asp-action="Index"
           class="btn btn-navy fw-semibold px-4 py-2 shadow-sm">
            <i class="bi bi-building me-1"></i> Browse Units
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm p-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm p-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center border-0 shadow-sm p-4" style="background-color: var(--bg-light); color: var(--navy-blue);">
            <i class="bi bi-info-circle fs-4 d-block mb-2"></i>
            You have not submitted any rental applications yet.
        </div>
    }
    else
    {
        <div class="card-custom shadow-sm border-0 overflow-hidden" style="border-radius: 0.5rem;">
            <div class="card-body p-0">
                <div class="table-responsive" style="border-radius: 0.5rem 0.5rem 0 0;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark" style="background-color: #0d346d !important; border-bottom: none; color: #ffffff !important;">
                            <tr>
                                <th class="py-3 ps-4 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit; border-top-left-radius: 0.5rem;">Application ID</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Unit</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Property</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Application Date</th>
                                <th class="py-3 pe-4 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit; border-top-right-radius: 0.5rem;">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var application in Model)
                            {
                                <tr style="transition: background-color 0.2s ease;">
                                    <td class="py-3 ps-4 fw-semibold text-navy">#@application.ApplicationId</td>

                                    <td class="py-3 fw-bold text-dark">
                                        @(application.Unit != null
                                                                        ? "Unit " + application.Unit.UnitNumber
                                                                        : "Unit #" + application.UnitId)
                            </td>

                                    <td class="py-3 text-secondary">
                                        <i class="bi bi-building me-1 opacity-70"></i> @(application.Unit?.Property?.Name ?? "N/A")
                                    </td>

                                    <td class="py-3 text-muted">
                                        <i class="bi bi-calendar3 me-1 opacity-70"></i> @application.ApplicationDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td class="py-3 pe-4">
                                @if (application.Status?.Name == "Approved")
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.8rem;">
                                                <i class="bi bi-check-circle me-1"></i> Approved
                                            </span>
                                        }
                                        else if (application.Status?.Name == "Rejected")
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.8rem;">
                                                <i class="bi bi-x-circle me-1"></i> Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.8rem;">
                                                <i class="bi bi-clock me-1"></i> @(application.Status?.Name ?? "Pending")
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>