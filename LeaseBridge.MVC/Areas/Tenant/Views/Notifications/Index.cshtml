@model IEnumerable<LeaseBridge.API.Models.Notification>

@{
    ViewData["Title"] = "My Notifications";
}

<div class="container mt-5">
    <div class="mb-5">
        <h2 class="text-navy fw-bold mb-1">My Notifications</h2>
        <p class="text-muted">
            View updates about your applications, payments, and maintenance requests.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm p-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm p-3 mb-4 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center border-0 shadow-sm p-4" style="background-color: var(--bg-light); color: var(--navy-blue);">
            <i class="bi bi-bell-slash fs-4 d-block mb-2"></i>
            No notifications found.
        </div>
    }
    else
    {
        <div class="card-custom shadow-sm border-0 overflow-hidden" style="border-radius: 0.5rem;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark" style="background-color: #0d346d !important; border-bottom: none; color: #ffffff !important;">
                            <tr>
                                <th class="py-3 ps-4 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit; border-top-left-radius: 0.5rem;">Message</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Type</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Status</th>
                                <th class="py-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.85rem; background-color: transparent; color: inherit;">Created</th>
                                <th class="py-3 pe-4 fw-semibold text-uppercase tracking-wider text-end" style="font-size: 0.85rem; background-color: transparent; color: inherit; border-top-right-radius: 0.5rem; width: 180px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var notification in Model)
                            {
                                <tr style="transition: background-color 0.2s ease; background-color: @(notification.IsRead ? "transparent" : "rgba(13, 52, 109, 0.03)");">
                                    <td class="py-3 ps-4">
                                        @if (!notification.IsRead)
                                        {
                                            <span class="text-dark fw-bold"><i class="bi bi-circle-fill text-primary me-2" style="font-size: 0.5rem; vertical-align: middle;"></i>@notification.Message</span>
                                        }
                                        else
                                        {
                                            <span class="text-secondary">@notification.Message</span>
                                        }
                                    </td>

                                    <td class="py-3 fw-medium text-dark">@(notification.NotificationType ?? "General")</td>

                                    <td class="py-3">
                                        @if (notification.IsRead)
                                        {
                                            <span class="badge bg-light text-secondary px-3 py-2 rounded-pill fw-semibold" style="font-size: 0.8rem; border: 1px solid #dee2e6;">Read</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.8rem;">Unread</span>
                                        }
                                    </td>

                                    <td class="py-3 text-muted" style="font-size: 0.9rem;">
                                        <i class="bi bi-calendar3 me-1 opacity-70"></i> @notification.CreatedAt.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td class="py-3 pe-4 text-end">
                                        <div class="d-inline-flex gap-2 justify-content-end align-items-center" style="min-width: 120px;">
                                            <a asp-area="Tenant"
                                               asp-controller="Notifications"
                                               asp-action="Details"
                                               asp-route-id="@notification.NotificationId"
                                               class="btn btn-sm btn-link text-decoration-none fw-semibold p-0"
                                               style="color: var(--navy-blue); font-size: 0.85rem;">
                                                View
                                            </a>

                                            @if (!notification.IsRead)
                                            {
                                                <span class="text-muted opacity-40">|</span>
                                                <form asp-area="Tenant"
                                                      asp-controller="Notifications"
                                                      asp-action="MarkAsRead"
                                                      asp-route-id="@notification.NotificationId"
                                                      method="post"
                                                      class="d-inline m-0">
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-link text-success text-decoration-none fw-semibold p-0"
                                                            style="font-size: 0.85rem;">
                                                        Mark Read
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>