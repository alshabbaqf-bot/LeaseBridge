@model LeaseBridge.API.Models.Notification

@{
    ViewData["Title"] = "Notification Details";
}

<div class="container mt-5" style="max-width: 750px;">
    
    <div class="card-custom mb-4 shadow-sm">
        <div class="card-header-navy">
            <h4 class="mb-0 fw-bold"><i class="bi bi-bell me-2"></i>Notification Details</h4>
        </div>

        <div class="card-body p-4">
      
            <dl class="row mb-0">
                <dt class="col-sm-4 text-navy fw-bold mb-3">Message</dt>
                <dd class="col-sm-8 mb-3 fw-semibold text-dark">@Model.Message</dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Type</dt>
                <dd class="col-sm-8 mb-3 text-dark">@(Model.NotificationType ?? "General")</dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Status</dt>
                <dd class="col-sm-8 mb-3">
                    @if (Model.IsRead)
                    {
                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill fw-semibold" style="font-size: 0.8rem; border: 1px solid #dee2e6;">
                            <i class="bi bi-envelope-open me-1"></i> Read
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm fw-semibold" style="font-size: 0.8rem;">
                            <i class="bi bi-envelope-fill me-1"></i> Unread
                        </span>
                    }
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Created At</dt>
                <dd class="col-sm-8 mb-3 text-muted">
                    <i class="bi bi-calendar3 me-1 opacity-70"></i> @Model.CreatedAt.ToString("dd MMM yyyy HH:mm")
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Related Maintenance Request</dt>
                <dd class="col-sm-8 mb-3 text-dark">
                    @(Model.MaintenanceRequestId.HasValue
                                        ? $"#{Model.MaintenanceRequestId.Value}"
                                        : "N/A")
                </dd>

                <dt class="col-sm-4 text-navy fw-bold mb-3">Related Application</dt>
                <dd class="col-sm-8 mb-3 text-dark">
                    @(Model.ApplicationId.HasValue
                                        ? $"#{Model.ApplicationId.Value}"
                                        : "N/A")
                </dd>
            </dl>

            <hr class="my-4" style="color: var(--pop-color); opacity: 0.2;" />

         
            <div class="d-flex gap-2 justify-content-end">
                <a asp-area="Tenant"
                   asp-controller="Notifications"
                   asp-action="Index"
                   class="btn btn-outline-navy fw-semibold px-4 py-2"
                   style="border: 2px solid var(--navy-blue); color: var(--navy-blue);">
                    <i class="bi bi-arrow-left me-1"></i> Back to Notifications
                </a>

                @if (!Model.IsRead)
                {
                    <form asp-area="Tenant"
                          asp-controller="Notifications"
                          asp-action="MarkAsRead"
                          asp-route-id="@Model.NotificationId"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-success fw-semibold px-4 py-2 shadow-sm">
                            <i class="bi bi-check2-all me-1"></i> Mark as Read
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>