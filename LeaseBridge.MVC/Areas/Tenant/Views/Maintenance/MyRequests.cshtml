@model IEnumerable<LeaseBridge.MVC.Areas.Tenant.Controllers.TenantMaintenanceViewModel>

@{
    ViewData["Title"] = "My Maintenance Requests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-navy">Maintenance Support Log</h2>
            <p class="text-muted mb-0">Track maintenance requests raised for your leased unit.</p>
        </div>

        <a asp-area="Tenant" asp-controller="Maintenance" asp-action="RaiseTicket"
           class="btn btn-navy rounded-pill px-4 shadow-sm">
            Open New Ticket
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle m-0">
                <thead class="table-header-custom text-white">
                    <tr>
                        <th class="p-3">Ticket Reference</th>
                        <th class="p-3">Subject</th>
                        <th class="p-3">Category</th>
                        <th class="p-3">Priority</th>
                        <th class="p-3">Date Raised</th>
                        <th class="p-3">Status</th>
                        <th class="p-3 text-center">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center p-5 text-muted">No maintenance requests have been submitted yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="p-3 fw-bold text-navy">@item.TicketNumber</td>

                                <td class="p-3">
                                    <div class="fw-semibold">@item.Title</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 250px;">
                                        @(item.Description ?? "No description provided.")
                                    </small>
                                </td>

                                <td class="p-3">@item.CategoryName</td>

                                <td class="p-3">
                                    @if (item.PriorityName?.ToLower() == "high" || item.PriorityName?.ToLower() == "urgent")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-3">@item.PriorityName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">@item.PriorityName</span>
                                    }
                                </td>

                                <td class="p-3">@item.CreatedAt.ToString("dd MMM yyyy")</td>

                                <td class="p-3">
                                    @if (item.StatusName?.ToLower() == "completed" || item.StatusName?.ToLower() == "resolved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-3">@item.StatusName</span>
                                    }
                                    else if (item.StatusName?.ToLower() == "in progress")
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-3">@item.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info rounded-pill px-3">@item.StatusName</span>
                                    }
                                </td>

                                <td class="p-3 text-center">
                                    <a asp-area="Tenant" asp-controller="Maintenance" asp-action="Details" asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-navy rounded-pill px-3 shadow-sm">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>