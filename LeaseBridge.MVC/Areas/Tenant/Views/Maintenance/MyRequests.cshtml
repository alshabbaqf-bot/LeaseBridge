@model IEnumerable<LeaseBridge.MVC.Areas.Tenant.Controllers.TenantMaintenanceViewModel>

@{
    ViewData["Title"] = "My Maintenance Requests";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Maintenance Support Log</h2>
            <p class="text-muted mb-0">
                Track maintenance requests raised for your leased unit.
            </p>
        </div>

        <a asp-area="Tenant"
           asp-controller="Maintenance"
           asp-action="RaiseTicket"
           class="btn btn-primary fw-bold shadow-sm">
            Open New Ticket
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <div class="card shadow-sm border rounded">
        <div class="table-responsive bg-white p-3 rounded">
            <table class="table table-hover align-middle m-0">
                <thead class="table-light">
                    <tr>
                        <th>Ticket Reference</th>
                        <th>Subject</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Date Raised</th>
                        <th>Status</th>
                        <th class="text-center">Details</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No maintenance requests have been submitted yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.TicketNumber</td>

                                <td>
                                    <span class="d-block fw-bold text-dark">@item.Title</span>
                                    <small class="text-muted d-inline-block text-truncate" style="max-width: 250px;">
                                        @(item.Description ?? "No description provided.")
                                    </small>
                                </td>

                                <td>@item.CategoryName</td>

                                <td>
                                    @if (item.PriorityName.Equals("High", StringComparison.OrdinalIgnoreCase) ||
                                                                item.PriorityName.Equals("Urgent", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-danger">@item.PriorityName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@item.PriorityName</span>
                                    }
                                </td>

                                <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (item.StatusName.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                                                                item.StatusName.Equals("Resolved", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">@item.StatusName</span>
                                    }
                                    else if (item.StatusName.Equals("In Progress", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark">@item.StatusName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white">@item.StatusName</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-area="Tenant"
                                       asp-controller="Maintenance"
                                       asp-action="Details"
                                       asp-route-id="@item.RequestId"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>