@{
    ViewData["Title"] = "Report Maintenance Issue";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="card-custom mb-4 shadow-sm">
        <div class="card-header-navy">
            <h4 class="mb-0 fw-bold"><i class="bi bi-wrench-adjustable me-2"></i>Report Maintenance Issue</h4>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-info border-0 shadow-sm p-3 mb-4 d-flex align-items-center" style="background-color: var(--bg-light); color: var(--navy-blue);">
                <i class="bi bi-person-badge fs-4 me-3"></i>
                <div>
                    <span class="d-block"><strong>Tenant:</strong> @ViewBag.TenantName</span>
                    <span class="d-block"><strong>Unit:</strong> @ViewBag.UnitNumber</span>
                </div>
            </div>

            <form asp-area="Tenant"
                  asp-controller="Maintenance"
                  asp-action="RaiseTicket"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Issue Title</label>
                    <input name="title"
                           class="form-control"
                           placeholder="Example: AC not working"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Category</label>
                    <select name="categoryId" class="form-select" required>
                        <option value="">-- Select Category --</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Priority</label>
                    <select name="priorityId" class="form-select" required>
                        <option value="">-- Select Priority --</option>
                        @foreach (var priority in ViewBag.Priorities)
                        {
                            <option value="@priority.PriorityId">@priority.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-navy">Describe the Issue</label>
                    <textarea name="description"
                              class="form-control"
                              rows="4"
                              placeholder="Describe the maintenance issue clearly..."
                              required></textarea>
                </div>

                <hr class="my-4" style="color: var(--pop-color); opacity: 0.2;" />

                <div class="d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-navy fw-semibold px-4 py-2 shadow-sm">
                        <i class="bi bi-file-earmark-plus me-1"></i> Submit Request Ticket
                    </button>
                    <a asp-area="Tenant"
                       asp-controller="Maintenance"
                       asp-action="MyRequests"
                       class="btn btn-outline-navy fw-semibold px-4 py-2"
                       style="border: 2px solid var(--navy-blue); color: var(--navy-blue);">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>

                    
                </div>
            </form>
        </div>
    </div>
</div>