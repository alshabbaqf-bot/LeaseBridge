@{
    ViewData["Title"] = "Report Maintenance Issue";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Report Maintenance Issue</h4>
        </div>

        <div class="card-body">
            <div class="alert alert-info">
                <strong>Tenant:</strong> @ViewBag.TenantName <br />
                <strong>Unit:</strong> @ViewBag.UnitNumber
            </div>

            <form asp-area="Tenant"
                  asp-controller="Maintenance"
                  asp-action="RaiseTicket"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Issue Title</label>
                    <input name="title"
                           class="form-control"
                           placeholder="Example: AC not working"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Category</label>
                    <select name="categoryId" class="form-select" required>
                        <option value="">-- Select Category --</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.CategoryId">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Priority</label>
                    <select name="priorityId" class="form-select" required>
                        <option value="">-- Select Priority --</option>
                        @foreach (var priority in ViewBag.Priorities)
                        {
                            <option value="@priority.PriorityId">@priority.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Describe the Issue</label>
<textarea name="description"
          class="form-control"
          rows="4"
          placeholder="Describe the maintenance issue clearly..."
          required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">
                        Submit Request Ticket
                    </button>

                    <a asp-area="Tenant"
                       asp-controller="Maintenance"
                       asp-action="MyRequests"
                       class="btn btn-secondary">
                        Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>